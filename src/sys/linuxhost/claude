#!/bin/bash
# claude -- Claude Code, la CLI officielle d'Anthropic, sur Korin PC (paquet claude-code ; docs/etude/LINUX-HOST.md).
# Le binaire officiel pour Linux x86-64, non modifié, téléchargé chez Anthropic à l'installation du paquet
# (/devtools/claude-code/claude, version et SHA-256 épinglés par le paquet), lancé par l'hôte Linux de Korin. On s'y
# connecte avec son compte Claude (abonnement) : la page de connexion s'ouvre dans Jet. C'est aussi la commande que
# Craft Anything trouve dans le PATH.
# Sa mise à jour automatique est coupée (elle repose sur des liens symboliques, que Korin n'a pas) : une nouvelle
# version vient avec une nouvelle version du paquet (Logiciels).
B=/devtools/claude-code/claude
if [ ! -f "$B" ]; then
	echo "claude : Claude Code n'est pas téléchargé ($B) : réinstallez le paquet claude-code (Logiciels, ou pkg install claude-code)" >&2
	exit 127
fi
export DISABLE_AUTOUPDATER=1
# les commandes de Linux avec leurs options (paquet unixtools, BusyBox : env, awk, xargs, sed -E, sort -k...) devant
# celles de /bin, pour Claude seulement : il écrit ses commandes comme sous Linux
[ ! -x /devtools/bin/busybox ] || case ":$PATH:" in *:/devtools/bin:*) ;; *) export PATH="/devtools/bin:$PATH" ;; esac
# le serveur MCP de Korin (korin-mcp : process, journal, fichiers, paquets, services, écran ; docs/MCP-KORIN.md) pour
# toutes les séances, EN PLUS des serveurs de l'utilisateur et des apps (claude mcp add, --mcp-config de KorinStudio) :
# managed-mcp.json de /etc/claude-code prendrait le contrôle exclusif des serveurs MCP (vérifié avec 2.1.330). La forme
# « --mcp-config=FICHIER » ne prend qu'une valeur (« --mcp-config FICHIER » avalerait l'invite qui suit) ; sans effet sur
# les sous-commandes (mcp list, --version : vérifié)
[ ! -f /etc/claude-code/mcp.json ] || set -- --mcp-config=/etc/claude-code/mcp.json "$@"
exec /bin/linuxhost run "$B" "$@"
