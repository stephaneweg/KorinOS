# imagekit.bi -- ImageKit of Onyx for BASIC, as far as ARMPI's runtime makes it (src/apps/basic/baskits.h).
kit imagekit 1
struct format 84 ik_format
field name 0 a 12
field extensions 12 a 40
field can_read 52 i
field can_write 56 i
field alpha 60 i
field animated 64 i
formats 0 i pi ik_formats out,max
