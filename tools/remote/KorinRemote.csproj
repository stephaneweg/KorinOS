<Project Sdk="Microsoft.NET.Sdk">
  <!-- Korin Remote: the client of rdpd (the window-level remote desktop of Korin). Each Korin
       window is a window of its own on the PC. .NET Framework 4.8 (on every Windows 10 / 11).
       Build: dotnet build -c Release (tools/remote/README.md). From Onyx Remote (MIT). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>KorinRemote</AssemblyName>
    <RootNamespace>KorinRemote</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>korinremote.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Korin Remote</AssemblyTitle>
    <Product>Korin Remote</Product>
    <Version>1.0.0</Version>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="korinremote.ico" LogicalName="korinremote.ico" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Security" />
  </ItemGroup>
</Project>
