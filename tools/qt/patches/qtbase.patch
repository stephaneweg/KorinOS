diff --git a/cmake/FindWrapSystemFreetype.cmake b/cmake/FindWrapSystemFreetype.cmake
index d0c27a9f..08b7eb04 100644
--- a/cmake/FindWrapSystemFreetype.cmake
+++ b/cmake/FindWrapSystemFreetype.cmake
@@ -48,6 +48,17 @@ if(WrapSystemFreetype_FOUND)
     add_library(WrapSystemFreetype::WrapSystemFreetype INTERFACE IMPORTED)
     target_link_libraries(WrapSystemFreetype::WrapSystemFreetype
                           INTERFACE "${__freetype_target_name}")
+    # Korin OS : libfreetype.a du paquet freetype-dev a des dépendances privées (brotli, libpng, zlib : son
+    # freetype2.pc) que FindFreetype ne lie pas ; en statique, on les ajoute (tools/qt, docs/etude/QT.md)
+    if(FREETYPE_LIBRARY MATCHES "\\.a$" OR FREETYPE_LIBRARY_RELEASE MATCHES "\\.a$")
+        foreach(__ft_dep brotlidec png16 z)
+            find_library(__ft_dep_path NAMES ${__ft_dep})
+            if(__ft_dep_path)
+                target_link_libraries(WrapSystemFreetype::WrapSystemFreetype INTERFACE "${__ft_dep_path}")
+            endif()
+            unset(__ft_dep_path CACHE)
+        endforeach()
+    endif()
 endif()
 unset(__freetype_target_name)
 unset(__freetype_found)
