+++ b/mkspecs/korin-g++/qplatformdefs.h
@@ -0,0 +1,43 @@
+// Korin OS : un Unix générique (newlib + libposix), pas Linux (tools/qt, docs/etude/QT.md).
+#ifndef QPLATFORMDEFS_H
+#define QPLATFORMDEFS_H
+
+#include "qglobal.h"
+
+#ifndef _GNU_SOURCE
+#  define _GNU_SOURCE
+#endif
+
+#include <unistd.h>
+#include <pthread.h>
+#include <dirent.h>
+#include <fcntl.h>
+#include <grp.h>
+#include <pwd.h>
+#include <signal.h>
+#include <dlfcn.h>
+
+#include <sys/types.h>
+#include <sys/ioctl.h>
+#include <sys/time.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <netinet/in.h>
+
+#include "../common/posix/qplatformdefs.h"
+
+#define QT_SOCKLEN_T        socklen_t
+#define QT_SNPRINTF         ::snprintf
+#define QT_VSNPRINTF        ::vsnprintf
+
+// (newlib ne le donne pas ; POSIX : 512 au moins)
+#include <limits.h>
+#ifndef _POSIX_PIPE_BUF
+#  define _POSIX_PIPE_BUF 512
+#endif
+
+#undef QT_OPEN_LARGEFILE
+#define QT_OPEN_LARGEFILE   0
+
+#endif // QPLATFORMDEFS_H
