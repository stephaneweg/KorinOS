+#
+# qmake configuration for korin-g++ (Korin OS, https://github.com/stephaneweg/KorinOS : tools/qt)
+#
+
+MAKEFILE_GENERATOR      = UNIX
+QMAKE_PLATFORM          = korin
+
+include(../common/unix.conf)
+
+QMAKE_LIBS              =
+QMAKE_INCDIR            =
+QMAKE_LIBDIR            =
+QMAKE_LIBS_THREAD       =
+
+QMAKE_AR                = x86_64-onyx-elf-ar cqs
+QMAKE_OBJCOPY           = x86_64-onyx-elf-objcopy
+QMAKE_NM                = x86_64-onyx-elf-nm -P
+QMAKE_RANLIB            =
+
+include(../common/gcc-base-unix.conf)
+include(../common/g++-unix.conf)
+load(qt_config)
