diff --git a/src/printsupport/dialogs/qprintdialog_unix.cpp b/src/printsupport/dialogs/qprintdialog_unix.cpp
index bdaa5fa0..ccff9b80 100644
--- a/src/printsupport/dialogs/qprintdialog_unix.cpp
+++ b/src/printsupport/dialogs/qprintdialog_unix.cpp
@@ -980,8 +980,25 @@ void QPrintDialog::setVisible(bool visible)
     QAbstractPrintDialog::setVisible(visible);
 }
 
+#if defined(Q_OS_KORIN)
+// Korin OS : le dialogue d'impression de PrinterKit (le plugin printsupport korin, tools/qt/printsupport) ;
+// 1 imprimer, 0 abandon, -1 : le dialogue de Qt. Faible : sans le plugin, le dialogue de Qt.
+extern "C" int qt_korin_print_dialog(QPrintDialog *dialog) __attribute__((weak));
+#endif
+
 int QPrintDialog::exec()
 {
+#if defined(Q_OS_KORIN)
+    if (qt_korin_print_dialog) {
+        const int r = qt_korin_print_dialog(this);
+        if (r >= 0) {
+            setResult(r ? QDialog::Accepted : QDialog::Rejected);
+            if (r)
+                emit accepted(printer());
+            return result();
+        }
+    }
+#endif
     return QAbstractPrintDialog::exec();
 }
 
