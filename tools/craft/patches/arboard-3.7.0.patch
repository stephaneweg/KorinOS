+//! Korin OS (tools/craft/patches/arboard-3.7.0.patch, docs/CRAFT.md) : le presse-papiers de Korin (le service clipd,
+//! par UIKit), par le relais de l'hôte egui de Korin (src/lib/egui-korin/csrc/host.c, lié au programme par
+//! egui-korin). Le texte seulement : une image ou des fichiers ne sont pas pris en charge.
+
+use std::borrow::Cow;
+use std::ffi::{c_char, c_long};
+#[cfg(feature = "image-data")]
+use std::path::Path;
+use std::path::PathBuf;
+
+#[cfg(feature = "image-data")]
+use crate::common::ImageData;
+use crate::common::Error;
+
+unsafe extern "C" {
+	fn kh_clip_set(s: *const c_char, n: c_long);
+	fn kh_clip_get(buf: *mut c_char, cap: c_long) -> c_long;
+}
+
+fn read() -> Option<String> {
+	let mut buf = vec![0u8; 1 << 20];
+	let n = unsafe { kh_clip_get(buf.as_mut_ptr().cast(), buf.len() as _) };
+	if n <= 0 {
+		return None;
+	}
+	let n = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());
+	Some(String::from_utf8_lossy(&buf[..n]).into_owned())
+}
+
+fn write(text: &str) {
+	unsafe { kh_clip_set(text.as_ptr().cast(), text.len() as _) }
+}
+
+pub(crate) struct Clipboard(());
+
+impl Clipboard {
+	pub(crate) fn new() -> Result<Self, Error> {
+		Ok(Self(()))
+	}
+}
+
+pub(crate) struct Get<'clipboard> {
+	_clipboard: &'clipboard mut Clipboard,
+}
+
+impl<'clipboard> Get<'clipboard> {
+	pub(crate) fn new(clipboard: &'clipboard mut Clipboard) -> Self {
+		Self { _clipboard: clipboard }
+	}
+
+	pub(crate) fn text(self) -> Result<String, Error> {
+		read().filter(|t| !t.is_empty()).ok_or(Error::ContentNotAvailable)
+	}
+
+	pub(crate) fn html(self) -> Result<String, Error> {
+		Err(Error::ContentNotAvailable)
+	}
+
+	#[cfg(feature = "image-data")]
+	pub(crate) fn image(self) -> Result<ImageData<'static>, Error> {
+		Err(Error::ContentNotAvailable)
+	}
+
+	pub(crate) fn file_list(self) -> Result<Vec<PathBuf>, Error> {
+		Err(Error::ContentNotAvailable)
+	}
+}
+
+pub(crate) struct Set<'clipboard> {
+	_clipboard: &'clipboard mut Clipboard,
+}
+
+impl<'clipboard> Set<'clipboard> {
+	pub(crate) fn new(clipboard: &'clipboard mut Clipboard) -> Self {
+		Self { _clipboard: clipboard }
+	}
+
+	pub(crate) fn text(self, data: Cow<'_, str>) -> Result<(), Error> {
+		write(&data);
+		Ok(())
+	}
+
+	/// Le texte de remplacement, s'il y en a un ; sinon le HTML tel quel.
+	pub(crate) fn html(self, html: Cow<'_, str>, alt: Option<Cow<'_, str>>) -> Result<(), Error> {
+		write(alt.as_deref().unwrap_or(&html));
+		Ok(())
+	}
+
+	#[cfg(feature = "image-data")]
+	pub(crate) fn image(self, _image: ImageData) -> Result<(), Error> {
+		Err(Error::ClipboardNotSupported)
+	}
+
+	#[cfg(feature = "image-data")]
+	#[allow(dead_code)]
+	fn _path(_p: &Path) {}
+
+	pub(crate) fn file_list(self, _file_list: &[impl AsRef<std::path::Path>]) -> Result<(), Error> {
+		Err(Error::ClipboardNotSupported)
+	}
+}
+
+pub(crate) struct Clear<'clipboard> {
+	_clipboard: &'clipboard mut Clipboard,
+}
+
+impl<'clipboard> Clear<'clipboard> {
+	pub(crate) fn new(clipboard: &'clipboard mut Clipboard) -> Self {
+		Self { _clipboard: clipboard }
+	}
+
+	pub(crate) fn clear(self) -> Result<(), Error> {
+		write("");
+		Ok(())
+	}
+}
