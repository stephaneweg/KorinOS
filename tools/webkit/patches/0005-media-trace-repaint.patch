+
+String MediaSourcePrivateOnyx::traceText()
+{
+    StringBuilder text;
+    text.append("appended "_s, s_traceAppended / 1024, " KB in "_s, s_traceAppends, " calls"_s);
+    s_traceAppended = 0;
+    s_traceAppends = 0;
+    for (auto& sourceBuffer : sourceBuffers())
+        text.append("; "_s, downcast<SourceBufferPrivateOnyx>(sourceBuffer.get()).traceText());
+    return text.toString();
+}
+
+String SourceBufferPrivateOnyx::traceText()
+{
+    StringBuilder text;
+    auto* store = this->store();
+    RefPtr mediaSource = mediaSourcePrivate();
+    for (auto& track : m_tracks) {
+        size_t bytes = 0;
+        av_us ahead = 0;
+        if (store && mediaSource && track.queueIndex >= 0 && m_queue >= 0)
+            ahead = av_store_queue_level(store, m_queue, track.queueIndex, toUs(mediaSource->currentTime()), &bytes);
+        text.append(track.isVideo ? "video"_s : "audio"_s, " queue "_s, ahead / 100000 / 10.0, " s "_s, bytes / 1024, " KB"_s,
+            track.wantsMore ? " (waits)"_s : ""_s, ' ');
+    }
+    return text.toString();
+}
