+// Korin: the page is painted again for a picture only when its last painting left the main thread at
+// least as much time as it took (half of it for the page's scripts, input, the site's player): a large
+// video on a big page painted by the processor (the PC's software path) shows fewer pictures instead of
+// taking the whole thread -- the page froze. The picture skipped is painted at the next poll if no
+// newer one came.
+void MediaPlayerPrivateOnyx::requestRepaint()
+{
+    RefPtr player = m_player.get();
+    if (!player)
+        return;
+    auto now = MonotonicTime::now();
+    // the gap between two repaints: the picture's own painting (once: at 30 images/s a 30 ms painting still shows them all), and twice how late the
+    // main thread runs its timers (a page busy painting, its scripts, a site's player)
+    auto gap = std::max(m_lastPaintDuration, m_lateness * 2);
+    if (m_painted && now - m_lastRepaintAsk < gap) {
+        if (!m_repaintPending)
+            m_repaintsSkipped++;
+        m_repaintPending = true;
+        return;
+    }
+    m_repaintPending = false;
+    m_lastRepaintAsk = now;
+    player->repaint();
+}
+
+void MediaPlayerPrivateOnyx::trace(const av_player_status& status)
+{
+    auto now = MonotonicTime::now();
+    if (!m_lastTrace) {
+        m_lastTrace = now;
+        m_tracedDecoded = status.decoded;
+        m_tracedDropped = status.dropped;
+        return;
+    }
+    auto elapsed = (now - m_lastTrace).seconds();
+    if (elapsed < 1)
+        return;
+    // (paused, ended: one line, then nothing until it plays again -- the log is small)
+    bool idle = status.paused || status.ended;
+    if (idle && m_traceIdle)
+        return;
+    m_traceIdle = idle;
+    unsigned painted = m_painted - m_tracedPainted;
+    auto paintMs = painted ? (m_paintTotal - m_tracedPaint).milliseconds() / painted : 0.0;
+    StringBuilder text;
+    text.append("trace t="_s, status.time / 100000 / 10.0, " s "_s, status.width, 'x', status.height,
+        " decoded "_s, static_cast<int>((status.decoded - m_tracedDecoded) / elapsed),
+        "/s painted "_s, static_cast<int>(painted / elapsed),
+        "/s dropped "_s, static_cast<int>((status.dropped - m_tracedDropped) / elapsed),
+        "/s repaints skipped "_s, static_cast<int>((m_repaintsSkipped - m_tracedSkipped) / elapsed),
+        "/s paint "_s, static_cast<int>(paintMs), " ms main-thread lateness "_s, static_cast<int>(m_lateness.milliseconds()), " ms decode "_s, static_cast<int>(status.decode_us / 1000), " ms; ready "_s, status.ready,
+        status.paused ? " paused"_s : ""_s, status.waiting ? " WAITING"_s : ""_s, status.seeking ? " seeking"_s : ""_s,
+        status.ended ? " ended"_s : ""_s, status.sound ? ""_s : " no-sound"_s, " sync "_s, static_cast<int>(status.sync_us / 1000), " ms"_s);
+#if ENABLE(MEDIA_SOURCE)
+    if (RefPtr mediaSource = m_mediaSourcePrivate)
+        text.append("; MSE "_s, mediaSource->traceText());
+#endif
+    mediaLog(text.toString());
+    m_lastTrace = now;
+    m_tracedDecoded = status.decoded;
+    m_tracedDropped = status.dropped;
+    m_tracedPainted = m_painted;
+    m_tracedSkipped = m_repaintsSkipped;
+    m_tracedPaint = m_paintTotal;
+}
+
 void MediaPlayerPrivateOnyx::paint(GraphicsContext& context, const FloatRect& rect)
 {
     if (context.paintingDisabled())
         return;
+    auto start = MonotonicTime::now();
     ensureImage();
     if (!m_image)
         return;
-    context.drawNativeImage(*m_image, rect, FloatRect { { }, m_image->size() });
+    // (bilinear: the video scaled to its box by the processor, every picture)
+    context.drawNativeImage(*m_image, rect, FloatRect { { }, m_image->size() }, { InterpolationQuality::Low });
+    // the page's painting for this picture: from the repaint asked to here is not known, this
+    // picture's own painting is (the page's main thread being late tells the rest: m_lateness)
+    m_lastPaintEnd = MonotonicTime::now();
+    m_lastPaintDuration = m_lastPaintEnd - start;
+    m_paintTotal += m_lastPaintEnd - start;
+    m_painted++;
 }
 
