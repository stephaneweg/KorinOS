+namespace WebCore {
+
+bool CDMProxyOnyx::copyKey(std::span<const uint8_t, 16> keyID, std::span<uint8_t, 16> key) const
+{
+    KeyIDType id;
+    id.append(std::span<const uint8_t> { keyID });
+    RefPtr handle = keyHandle(id);
+    if (!handle || !handle->isStatusCurrentlyValid())
+        return false;
+    auto* value = std::get_if<Vector<uint8_t>>(&handle->value());
+    if (!value || value->size() != 16)
+        return false;
+    memcpy(key.data(), value->span().data(), 16);
+    return true;
+}
+
+void CDMProxyOnyx::setWaitingForKey(bool waiting) const
+{
+    if (!instance())
+        return;
+    if (waiting)
+        startedWaitingForKey();
+    else
+        stoppedWaitingForKey();
+}
+
+// the key systems of the Onyx engine: Clear Key (WebKit's CDM, keys decrypted in the page's process)
+class CDMProxyFactoryOnyx final : public CDMProxyFactory {
+protected:
+    RefPtr<CDMProxy> createCDMProxy(const String& keySystem) final
+    {
+        if (supportsKeySystem(keySystem))
+            return CDMProxyOnyx::create();
+        return nullptr;
+    }
+    bool supportsKeySystem(const String& keySystem) final { return keySystem == "org.w3.clearkey"_s; }
+};
+
+void CDMFactory::platformRegisterFactories(Vector<WeakRef<CDMFactory>>& factories)
+{
+    factories.append(CDMFactoryClearKey::singleton());
+}
+
+Vector<CDMProxyFactory*> CDMProxyFactory::platformRegisterFactories()
+{
+    static NeverDestroyed<CDMProxyFactoryOnyx> factory;
+    return { &factory.get() };
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(ENCRYPTED_MEDIA) && PLATFORM(ONYX)
