+#pragma once
+
+#if ENABLE(ENCRYPTED_MEDIA) && PLATFORM(ONYX)
+
+#include "CDMProxy.h"
+#include <span>
+
+namespace WebCore {
+
+// EME for the Onyx media engine (Korin OS, docs/etude/WIDEVINE.md): the decryptor's side of a CDM
+// instance. The page's sessions (WebKit's Clear Key CDM, CDMClearKey) give their keys to this proxy;
+// the player's decoding threads read them (MediaPlayerPrivateOnyx's decryptor, av_decrypt).
+class CDMProxyOnyx final : public CDMProxy {
+public:
+    static Ref<CDMProxyOnyx> create() { return adoptRef(*new CDMProxyOnyx); }
+
+    // Any thread: the 16-byte AES key of a key ID -> true; false: no usable key for it (yet).
+    bool copyKey(std::span<const uint8_t, 16> keyID, std::span<uint8_t, 16> key) const;
+    // Any thread: a decoding thread starts / stops waiting for a key (the media element's
+    // waitingforkey, MediaPlayer::waitingForKeyChanged).
+    void setWaitingForKey(bool) const;
+
+private:
+    CDMProxyOnyx() = default;
+};
+
+} // namespace WebCore
+
+#endif // ENABLE(ENCRYPTED_MEDIA) && PLATFORM(ONYX)
