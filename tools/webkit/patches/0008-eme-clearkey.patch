+
+// ---- EME (Korin OS, docs/etude/WIDEVINE.md) ----
+
+void MediaPlayerPrivateOnyx::encryptedInitializationData(const String& initDataType, std::span<const uint8_t> initData)
+{
+    if (RefPtr player = m_player.get())
+        player->initializationDataEncountered(initDataType, ArrayBuffer::create(initData));
+}
+
+void MediaPlayerPrivateOnyx::cdmInstanceAttached(CDMInstance& instance)
+{
+    // (the instances of the key systems the Onyx engine registers are proxies: CDMOnyx.cpp)
+    if (instance.implementationType() != CDMInstance::ImplementationType::ClearKey)
+        return;
+    auto& proxyInstance = static_cast<CDMInstanceProxy&>(instance);
+    if (RefPtr player = m_player.get())
+        proxyInstance.setPlayer(ThreadSafeWeakPtr<MediaPlayer> { *player });
+    RefPtr<CDMProxy> proxy = proxyInstance.proxy();
+    {
+        Locker locker { m_cdmLock };
+        m_cdmProxy = static_cast<CDMProxyOnyx*>(proxy.get());
+    }
+    if (ensurePlayer())
+        av_player_kick(m_av);
+}
+
+void MediaPlayerPrivateOnyx::cdmInstanceDetached(CDMInstance&)
+{
+    Locker locker { m_cdmLock };
+    m_cdmProxy = nullptr;
+}
+
+void MediaPlayerPrivateOnyx::attemptToDecryptWithInstance(CDMInstance&)
+{
+    // (the decoding threads ask the proxy again for the key they wait for: nothing to do here)
+    if (m_av)
+        av_player_kick(m_av);
+}
+
+// The player's audio and video threads: an encrypted packet decrypted in place with the key its CDM
+// instance received -> AV_OK ; AV_AGAIN: no key yet (the thread asks again; the element is told it waits)
+int MediaPlayerPrivateOnyx::decryptPacket(void* context, const av_track*, av_packet* packet)
+{
+    auto* self = static_cast<MediaPlayerPrivateOnyx*>(context);
+    RefPtr<CDMProxyOnyx> proxy;
+    {
+        Locker locker { self->m_cdmLock };
+        proxy = self->m_cdmProxy;
+    }
+    uint8_t key[16];
+    if (!proxy || !packet->crypt || !proxy->copyKey(std::span<const uint8_t, 16> { packet->crypt->kid, 16 }, std::span<uint8_t, 16> { key, 16 })) {
+        if (proxy && !self->m_waitingForKey.exchange(true))
+            proxy->setWaitingForKey(true);
+        return AV_AGAIN;
+    }
+    if (self->m_waitingForKey.exchange(false))
+        proxy->setWaitingForKey(false);
+    int result = av_decrypt(packet, key);
+    memset(key, 0, sizeof key);
+    return result == AV_OK ? AV_OK : AV_ERR;
+}
+
+#endif // ENABLE(ENCRYPTED_MEDIA)
+
 } // namespace WebCore
 
 #endif // ENABLE(VIDEO) && PLATFORM(ONYX)
