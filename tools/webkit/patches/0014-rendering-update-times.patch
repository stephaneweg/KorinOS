 // https://html.spec.whatwg.org/multipage/webappapis.html#update-the-rendering
+// Korin (22/11/2026, docs/agents/JET-TF1-DEFILEMENT.md) : le temps de chaque étape de la mise à jour de l'affichage,
+// avec ONYX_WEB_GPU_DEBUG ou /etc/web-gpu-debug : une ligne « web: gpu: steps: » toutes les 2 s (TF1+ : ≈ 500 ms par
+// image en défilant le haut de la page, sans savoir quelle étape).
+namespace KorinRenderTimes {
+static bool enabled()
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* v = getenv("ONYX_WEB_GPU_DEBUG");
+        on = (v && *v && *v != '0') || !access("/etc/web-gpu-debug", F_OK);
+    }
+    return on;
+}
+static double stepMs[32];
+static double layoutMs, compositingLayoutMs, afterMs, flushMs, totalMs, maxMs;
+static unsigned updates;
+static MonotonicTime since;
+static void add(RenderingUpdateStep step, Seconds s)
+{
+    stepMs[std::countr_zero(static_cast<uint32_t>(step)) & 31] += s.milliseconds();
+}
+static void report()
+{
+    auto now = MonotonicTime::now();
+    if (!since)
+        since = now;
+    if (now - since < 2_s)
+        return;
+    if (updates) {
+        Vector<std::pair<double, unsigned>> order;
+        for (unsigned i = 0; i < 32; ++i) {
+            if (stepMs[i] >= 1)
+                order.append({ stepMs[i], i });
+        }
+        std::sort(order.begin(), order.end(), [](auto& a, auto& b) { return a.first > b.first; });
+        StringBuilder line;
+        line.append("web: gpu: steps: "_s, String::number(updates), " updates, "_s, String::number(static_cast<int>(totalMs)), " ms (worst "_s,
+            String::number(static_cast<int>(maxMs)), " ms); layout "_s, String::number(static_cast<int>(layoutMs)), ", compositing layout "_s,
+            String::number(static_cast<int>(compositingLayoutMs)), ", after "_s, String::number(static_cast<int>(afterMs)), ", layer flush "_s,
+            String::number(static_cast<int>(flushMs)));
+        double accounted = layoutMs + compositingLayoutMs + afterMs;
+        for (double ms : stepMs)
+            accounted += ms;
+        line.append(", other "_s, String::number(static_cast<int>(totalMs - accounted)));
+        for (size_t k = 0; k < order.size() && k < 8; ++k) {
+            TextStream ts;
+            ts << static_cast<RenderingUpdateStep>(1u << order[k].second);
+            line.append(", "_s, ts.release(), ' ', String::number(static_cast<int>(order[k].first)));
+        }
+        line.append('\n');
+        auto utf8 = line.toString().utf8();
+        (void)!write(STDERR_FILENO, utf8.data(), utf8.length());
+    }
+    since = now;
+    std::fill(std::begin(stepMs), std::end(stepMs), 0);
+    layoutMs = compositingLayoutMs = afterMs = flushMs = totalMs = maxMs = 0;
+    updates = 0;
+}
+}
