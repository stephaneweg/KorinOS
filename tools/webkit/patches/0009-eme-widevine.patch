+
+uint32_t CDMInstanceWidevineOnyx::addPromise(PromiseHandler&& handler)
+{
+    uint32_t promise = m_nextPromise++;
+    if (!m_nextPromise)
+        m_nextPromise = 1;
+    m_promises.set(promise, WTF::move(handler));
+    return promise;
+}
+
+void CDMInstanceWidevineOnyx::addSession(const String& sessionId, CDMInstanceSessionWidevineOnyx& session)
+{
+    m_sessions.set(sessionId, WeakPtr { session });
+}
+
+void CDMInstanceWidevineOnyx::removeSession(const String& sessionId)
+{
+    m_sessions.remove(sessionId);
+    m_earlyMessages.remove(sessionId);
+}
+
+std::optional<std::pair<uint32_t, Vector<uint8_t>>> CDMInstanceWidevineOnyx::takeEarlyMessage(const String& sessionId)
+{
+    auto it = m_earlyMessages.find(sessionId);
+    if (it == m_earlyMessages.end())
+        return std::nullopt;
+    auto message = WTF::move(it->value);
+    m_earlyMessages.remove(it);
+    return message;
+}
+
+void CDMInstanceWidevineOnyx::handleEvent(CdmIn& event)
+{
+    auto settle = [&](uint32_t promise, bool resolved, const String& sessionId) {
+        if (auto handler = m_promises.take(promise))
+            handler(resolved, sessionId);
+    };
+    auto sessionOf = [&](const std::string& id) -> std::pair<String, CDMInstanceSessionWidevineOnyx*> {
+        String sessionId = String::fromUTF8(id.c_str());
+        auto it = m_sessions.find(sessionId);
+        return { sessionId, it == m_sessions.end() ? nullptr : it->value.get() };
+    };
+
+    switch (event.type) {
+    case CDM_EV_INITIALIZED: {
+        bool ok = event.u32();
+        if (m_initCallback)
+            m_initCallback(ok ? SuccessValue::Succeeded : SuccessValue::Failed);
+        break;
+    }
+    case CDM_EV_RESOLVED:
+        settle(event.u32(), true, { });
+        break;
+    case CDM_EV_REJECTED: {
+        uint32_t promise = event.u32();
+        uint32_t exception = event.u32();
+        uint32_t code = event.u32();
+        std::string message = event.str();
+        WTFLogAlways("Widevine: promise %u rejected (%u, %u): %s", promise, exception, code, message.c_str());
+        settle(promise, false, { });
+        break;
+    }
+    case CDM_EV_NEW_SESSION: {
+        uint32_t promise = event.u32();
+        std::string id = event.str();
+        settle(promise, event.ok, String::fromUTF8(id.c_str()));
+        break;
+    }
+    case CDM_EV_MESSAGE: {
+        auto [sessionId, session] = sessionOf(event.str());
+        uint32_t type = event.u32();
+        Vector<uint8_t> message = toWTF(event.blk());
+        if (session)
+            session->message(type, WTF::move(message));
+        else if (!sessionId.isEmpty())
+            m_earlyMessages.set(sessionId, std::pair { type, WTF::move(message) });
+        break;
+    }
+    case CDM_EV_KEYS_CHANGE: {
+        auto [sessionId, session] = sessionOf(event.str());
+        event.u32(); // (a new usable key)
+        uint32_t count = event.u32();
+        Vector<std::pair<Vector<uint8_t>, uint32_t>> keys;
+        for (uint32_t i = 0; event.ok && i < count && i < 1024; i++) {
+            Vector<uint8_t> keyID = toWTF(event.blk());
+            uint32_t status = event.u32();
+            keys.append({ WTF::move(keyID), status });
+        }
+        if (session && event.ok)
+            session->keysChanged(WTF::move(keys));
+        break;
+    }
+    case CDM_EV_CLOSED: {
+        auto [sessionId, session] = sessionOf(event.str());
+        if (session)
+            session->closedByHost();
+        break;
+    }
+    case CDM_EV_EXPIRATION:
+        break;
+    default: {
+        // the host is gone (or said something unknown): what was awaited fails
+        WTFLogAlways("Widevine: the CDM host is gone");
+        auto promises = std::exchange(m_promises, { });
+        for (auto& handler : promises.values())
+            handler(false, { });
+        if (m_initCallback)
+            m_initCallback(SuccessValue::Failed);
+        break;
+    }
+    }
+}
+
+// ---- the sessions ----
+
+static CDMKeyStatus keyStatusOf(uint32_t status)
+{
+    switch (status) {
+    case 0: return CDMKeyStatus::Usable;
+    case 2: return CDMKeyStatus::Expired;
+    case 3: return CDMKeyStatus::OutputRestricted;
+    case 4: return CDMKeyStatus::OutputDownscaled;
+    case 5: return CDMKeyStatus::StatusPending;
+    case 6: return CDMKeyStatus::Released;
+    default: return CDMKeyStatus::InternalError;
+    }
+}
