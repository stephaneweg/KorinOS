+// instance. Clear Key: the page's sessions (WebKit's CDMClearKey) give their keys to this proxy; the
+// player's decoding threads read them (MediaPlayerPrivateOnyx's decryptor, av_decrypt). Widevine: the keys
+// stay in the CDM host (cdmhost, CDMWidevineOnyx); the proxy knows their IDs and statuses, and the host,
+// which decrypts the audio and decodes the video.
 class CDMProxyOnyx final : public CDMProxy {
 public:
     static Ref<CDMProxyOnyx> create() { return adoptRef(*new CDMProxyOnyx); }
 
     // Any thread: the 16-byte AES key of a key ID -> true; false: no usable key for it (yet).
     bool copyKey(std::span<const uint8_t, 16> keyID, std::span<uint8_t, 16> key) const;
+    // Any thread: a usable key for this ID (its value in the proxy or in the host)
+    bool hasUsableKey(std::span<const uint8_t, 16> keyID) const;
     // Any thread: a decoding thread starts / stops waiting for a key (the media element's
     // waitingforkey, MediaPlayer::waitingForKeyChanged).
     void setWaitingForKey(bool) const;
 
+    // The CDM host of a key system that runs in one (Widevine); null: the keys are here (Clear Key).
+    void setHost(std::shared_ptr<CdmHostClient>);
+    std::shared_ptr<CdmHostClient> host() const;
+
 private:
     CDMProxyOnyx() = default;
+
+    mutable Lock m_hostLock;
+    std::shared_ptr<CdmHostClient> m_host WTF_GUARDED_BY_LOCK(m_hostLock);
 };
 
 } // namespace WebCore
