+
+bool CDMFactoryWidevineOnyx::supportsKeySystem(const String& keySystem)
+{
+    // (offered only when Google's module and the host are installed: the page then picks another way)
+    return equalLettersIgnoringASCIICase(keySystem, "com.widevine.alpha"_s)
+        && !access(modulePath().c_str(), R_OK) && !access(hostPath().c_str(), X_OK);
+}
+
+Vector<String> CDMPrivateWidevineOnyx::supportedInitDataTypes() const
+{
+    return { InitDataRegistry::cencName(), InitDataRegistry::keyidsName(), InitDataRegistry::webmName() };
+}
+
+Vector<String> CDMPrivateWidevineOnyx::supportedRobustnesses() const
+{
+    // the software CDM (L3): no hardware robustness
+    return { emptyString(), "SW_SECURE_CRYPTO"_s, "SW_SECURE_DECODE"_s };
+}
+
+static bool wantsPersistentLicense(const CDMKeySystemConfiguration& configuration)
+{
+    return configuration.sessionTypes.contains(CDMSessionType::PersistentLicense);
+}
+
+bool CDMPrivateWidevineOnyx::supportsConfiguration(const CDMKeySystemConfiguration& configuration) const
+{
+    // (the Linux module keeps no license: temporary sessions only; no distinctive identifier, as Chromium on Linux)
+    return configuration.distinctiveIdentifier != CDMRequirement::Required && !wantsPersistentLicense(configuration);
+}
+
+bool CDMPrivateWidevineOnyx::supportsConfigurationWithRestrictions(const CDMKeySystemConfiguration& configuration, const CDMRestrictions& restrictions) const
+{
+    if (configuration.persistentState == CDMRequirement::Required && restrictions.persistentStateDenied)
+        return false;
+    return supportsConfiguration(configuration);
+}
+
+bool CDMPrivateWidevineOnyx::supportsSessionTypeWithConfiguration(const CDMSessionType& sessionType, const CDMKeySystemConfiguration& configuration) const
+{
+    return sessionType == CDMSessionType::Temporary && supportsConfiguration(configuration);
+}
+
+CDMRequirement CDMPrivateWidevineOnyx::distinctiveIdentifiersRequirement(const CDMKeySystemConfiguration&, const CDMRestrictions&) const
+{
+    return CDMRequirement::NotAllowed;
+}
+
+CDMRequirement CDMPrivateWidevineOnyx::persistentStateRequirement(const CDMKeySystemConfiguration&, const CDMRestrictions& restrictions) const
+{
+    return restrictions.persistentStateDenied ? CDMRequirement::NotAllowed : CDMRequirement::Optional;
+}
