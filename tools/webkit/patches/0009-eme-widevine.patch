+void CDMInstanceSessionWidevineOnyx::loadSession(LicenseType, const String&, const String&, LoadSessionCallback&& callback)
+{
+    callback(std::nullopt, std::nullopt, std::nullopt, SuccessValue::Failed, SessionLoadFailure::Other);
+}
