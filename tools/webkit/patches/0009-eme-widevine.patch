+static const char* keySystemName = "com.widevine.alpha";
+
+static std::string homeDirectory()
+{
+    const char* home = getenv("HOME");
+    return home && *home ? home : "/home";
+}
+
+static std::string modulePath()
+{
+    if (const char* path = getenv("JET_WIDEVINE_CDM"); path && *path)
+        return path;
+    return homeDirectory() + "/.jet/widevine/libwidevinecdm.so";
+}
+
+static std::string hostPath()
+{
+    if (const char* path = getenv("JET_CDMHOST"); path && *path)
+        return path;
+    return "/apps/jet.app/cdmhost";
+}
+
+static std::string storagePath()
+{
+    std::string jet = homeDirectory() + "/.jet";
+    mkdir(jet.c_str(), 0700);
+    mkdir((jet + "/widevine").c_str(), 0700);
+    std::string storage = jet + "/widevine/storage";
+    mkdir(storage.c_str(), 0700);
+    return storage;
+}
+
+static std::vector<uint8_t> toStd(std::span<const uint8_t> data)
+{
+    return std::vector<uint8_t>(data.begin(), data.end());
+}
+
+static std::string toStdString(const String& string)
+{
+    CString utf8 = string.utf8();
+    return std::string(reinterpret_cast<const char*>(utf8.data()), utf8.length());
+}
+
+static Vector<uint8_t> toWTF(const std::vector<uint8_t>& data)
+{
+    return Vector<uint8_t>(std::span<const uint8_t> { data.data(), data.size() });
+}
