+void CDMInstanceSessionWidevineOnyx::requestLicense(LicenseType type, KeyGroupingStrategy, const String& initDataType, Ref<SharedBuffer>&& initData, LicenseCallback&& callback)
+{
+    auto* parent = parentInstance();
+    if (!parent || !parent->host() || type != LicenseType::Temporary) {
+        callback(SharedBuffer::create(), emptyString(), false, SuccessValue::Failed);
+        return;
+    }
+    uint32_t dataType = equalLettersIgnoringASCIICase(initDataType, "keyids"_s) ? 1 : equalLettersIgnoringASCIICase(initDataType, "webm"_s) ? 2 : 0;
+    m_licenseCallback = WTF::move(callback);
+    uint32_t promise = parent->addPromise([weakThis = WeakPtr<CDMInstanceSessionProxy> { *this }](bool resolved, const String& sessionId) {
+        auto* session = static_cast<CDMInstanceSessionWidevineOnyx*>(weakThis.get());
+        if (!session)
+            return;
+        auto* parent = session->parentInstance();
+        if (!resolved || sessionId.isEmpty() || !parent) {
+            if (auto licenseCallback = WTF::move(session->m_licenseCallback))
+                licenseCallback(SharedBuffer::create(), emptyString(), false, SuccessValue::Failed);
+            return;
+        }
+        session->m_sessionId = sessionId;
+        parent->addSession(sessionId, *session);
+        if (auto early = parent->takeEarlyMessage(sessionId))
+            session->message(early->first, WTF::move(early->second));
+    });
+    if (!parent->host()->create_session(promise, 0, dataType, toStd(initData->span())))
+        parent->handleEvent(*std::make_unique<CdmIn>());
+}
+
+void CDMInstanceSessionWidevineOnyx::message(uint32_t type, Vector<uint8_t>&& message)
+{
+    // the first is the license request that generateRequest awaits; the others (renewals) go to the page
+    if (auto licenseCallback = WTF::move(m_licenseCallback)) {
+        licenseCallback(SharedBuffer::create(WTF::move(message)), m_sessionId, false, SuccessValue::Succeeded);
+        return;
+    }
+    if (m_client)
+        m_client->sendMessage(static_cast<CDMMessageType>(type <= 3 ? type : 0), SharedBuffer::create(WTF::move(message)));
+}
+
+void CDMInstanceSessionWidevineOnyx::updateLicense(const String& sessionId, LicenseType, Ref<SharedBuffer>&& response, LicenseUpdateCallback&& callback)
+{
+    auto* parent = parentInstance();
+    if (!parent || !parent->host()) {
+        callback(false, std::nullopt, std::nullopt, std::nullopt, SuccessValue::Failed);
+        return;
+    }
+    m_updating = true;
+    uint32_t promise = parent->addPromise([weakThis = WeakPtr<CDMInstanceSessionProxy> { *this }, callback = WTF::move(callback)](bool resolved, const String&) mutable {
+        auto* session = static_cast<CDMInstanceSessionWidevineOnyx*>(weakThis.get());
+        if (!session || !resolved) {
+            if (session)
+                session->m_updating = false;
+            callback(false, std::nullopt, std::nullopt, std::nullopt, SuccessValue::Failed);
+            return;
+        }
+        session->m_updating = false;
+        // (the module gives the keys before it resolves the update: they are in the store)
+        callback(false, session->m_keyStore.convertToJSKeyStatusVector(), std::nullopt, std::nullopt, SuccessValue::Succeeded);
+    });
+    if (!parent->host()->update_session(promise, toStdString(sessionId), toStd(response->span())))
+        parent->handleEvent(*std::make_unique<CdmIn>());
+}
+
+void CDMInstanceSessionWidevineOnyx::keysChanged(Vector<std::pair<Vector<uint8_t>, uint32_t>>&& keys)
+{
+    auto* parent = parentInstance();
+    if (parent)
+        parent->unrefAllKeysFrom(m_keyStore);
+    m_keyStore.clear();
+    // (the values stay in the host: the proxy knows the IDs and their statuses)
+    for (auto& [keyID, status] : keys)
+        m_keyStore.add(KeyHandle::create(keyStatusOf(status), WTF::move(keyID), KeyHandleValueVariant { Vector<uint8_t> { } }));
+    if (parent)
+        parent->mergeKeysFrom(m_keyStore);
+    if (!m_updating && m_client)
+        m_client->updateKeyStatuses(m_keyStore.convertToJSKeyStatusVector());
+}
+
+void CDMInstanceSessionWidevineOnyx::closedByHost()
+{
+    if (auto* parent = parentInstance())
+        parent->unrefAllKeysFrom(m_keyStore);
+    m_keyStore.clear();
+    if (m_client)
+        m_client->updateKeyStatuses({ });
+}
+
+void CDMInstanceSessionWidevineOnyx::closeSession(const String& sessionId, CloseSessionCallback&& callback)
+{
+    auto* parent = parentInstance();
+    if (!parent || !parent->host()) {
+        callback();
+        return;
+    }
+    parent->unrefAllKeysFrom(m_keyStore);
+    m_keyStore.clear();
+    uint32_t promise = parent->addPromise([callback = WTF::move(callback)](bool, const String&) mutable {
+        callback();
+    });
+    bool sent = parent->host()->close_session(promise, toStdString(sessionId));
+    parent->removeSession(sessionId);
+    if (!sent)
+        parent->handleEvent(*std::make_unique<CdmIn>());
+}
