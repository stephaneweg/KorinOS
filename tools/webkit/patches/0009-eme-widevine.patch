+// The decoder of an encrypted video track (the player's factory, av_player_set_decoder_factory): which one
+// is known only when its packets come, after the page has given its MediaKeys -- the CDM host's
+// (Widevine: the packets come still encrypted), else the library's (Clear Key: they come decrypted).
+struct EncryptedVideoDecoderOnyx {
+    MediaPlayerPrivateOnyx* player;
+    av_track track;                 // (a copy, with its own codec setup)
+    std::vector<uint8_t> extra;
+    av_decoder* inner { nullptr };
+    bool inHost { false };
+
+    void bind(bool wantHost)
+    {
+        if (inner)
+            av_decoder_free(inner);
+        inner = nullptr;
+        inHost = false;
+        RefPtr<CDMProxyOnyx> proxy = wantHost ? player->currentCDMProxy() : nullptr;
+        if (std::shared_ptr<CdmHostClient> host = proxy ? proxy->host() : nullptr) {
+            inner = widevineVideoDecoder(WTF::move(host), track);
+            inHost = inner;
+        }
+        if (!inner)
+            inner = av_decoder_new(&track);
+    }
+
+    static int send(void* context, const av_packet* packet)
+    {
+        auto& self = *static_cast<EncryptedVideoDecoderOnyx*>(context);
+        // (a packet left encrypted is the host's; the clear start of a stream, anyone's)
+        if (!self.inner || (packet && packet->crypt && !self.inHost))
+            self.bind(true);
+        return self.inner ? av_decoder_send(self.inner, packet) : AV_ERR;
+    }
+    static int receive(void* context, av_frame* frame)
+    {
+        auto& self = *static_cast<EncryptedVideoDecoderOnyx*>(context);
+        return self.inner ? av_decoder_receive(self.inner, frame) : AV_AGAIN;
+    }
+    static void flush(void* context)
+    {
+        auto& self = *static_cast<EncryptedVideoDecoderOnyx*>(context);
+        if (self.inner)
+            av_decoder_flush(self.inner);
+    }
+    static void close(void* context)
+    {
+        auto* self = static_cast<EncryptedVideoDecoderOnyx*>(context);
+        if (self->inner)
+            av_decoder_free(self->inner);
+        delete self;
+    }
+};
+
+av_decoder* MediaPlayerPrivateOnyx::createDecoder(void* context, const av_track* track)
+{
+    static const av_decoder_ops ops = { "encrypted", EncryptedVideoDecoderOnyx::send, EncryptedVideoDecoderOnyx::receive,
+        EncryptedVideoDecoderOnyx::flush, EncryptedVideoDecoderOnyx::close };
+    // (the audio: the library's decoder, after the decryptor -- the CDM host's Decrypt for Widevine)
+    if (!track || track->kind != AV_VIDEO)
+        return nullptr;
+    auto* decoder = new EncryptedVideoDecoderOnyx { static_cast<MediaPlayerPrivateOnyx*>(context), *track, { } };
+    if (track->extra && track->extra_len)
+        decoder->extra.assign(track->extra, track->extra + track->extra_len);
+    decoder->track.extra = decoder->extra.empty() ? nullptr : decoder->extra.data();
+    decoder->track.extra_len = decoder->extra.size();
+    av_decoder* external = av_decoder_external(&ops, decoder);
+    if (!external)
+        delete decoder;
+    return external;
+}
