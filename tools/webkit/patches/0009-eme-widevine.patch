+CDMInstanceSessionWidevineOnyx::~CDMInstanceSessionWidevineOnyx()
+{
+    if (auto* parent = parentInstance(); parent && !m_sessionId.isEmpty()) {
+        parent->unrefAllKeysFrom(m_keyStore);
+        parent->removeSession(m_sessionId);
+    }
+}
