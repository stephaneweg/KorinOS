+// ---- the instance: the host and its events ----
+
+// the host's events, from the instance's reading thread to the main thread (the instance may be gone)
+class CDMWidevineEventSink : public ThreadSafeRefCounted<CDMWidevineEventSink> {
+public:
+    static Ref<CDMWidevineEventSink> create(CDMInstanceWidevineOnyx& instance) { return adoptRef(*new CDMWidevineEventSink(instance)); }
+
+    CDMInstanceWidevineOnyx* instance { nullptr }; // main thread
+    std::atomic<bool> stop { false };
+
+private:
+    explicit CDMWidevineEventSink(CDMInstanceWidevineOnyx& instance)
+        : instance(&instance) { }
+};
+
+CDMInstanceWidevineOnyx::CDMInstanceWidevineOnyx()
+    : CDMInstanceProxy(String::fromLatin1(keySystemName))
+{
+}
+
+CDMInstanceWidevineOnyx::~CDMInstanceWidevineOnyx()
+{
+    if (m_sink) {
+        m_sink->instance = nullptr;
+        m_sink->stop = true; // (the thread ends within its poll's wait, and lets the host go: cdmhost ends)
+    }
+    if (RefPtr cdmProxy = proxy())
+        static_cast<CDMProxyOnyx&>(*cdmProxy).setHost(nullptr);
+}
