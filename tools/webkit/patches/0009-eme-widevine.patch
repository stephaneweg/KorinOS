+    return name;
+}
+
+void CDMInstanceWidevineOnyx::initializeWithConfiguration(const CDMKeySystemConfiguration&, AllowDistinctiveIdentifiers distinctiveIdentifiers, AllowPersistentState persistentState, SuccessCallback&& callback)
+{
+    if (m_host) {
+        callback(SuccessValue::Succeeded);
+        return;
+    }
+    std::unique_ptr<CdmHostClient> host = CdmHostClient::spawn(hostPath(), modulePath(), storagePath());
+    if (!host || !host->init(keySystemName, distinctiveIdentifiers == AllowDistinctiveIdentifiers::Yes, persistentState == AllowPersistentState::Yes)) {
+        WTFLogAlways("Widevine: the CDM host (%s) did not start", hostPath().c_str());
+        callback(SuccessValue::Failed);
+        return;
+    }
+    m_host = std::shared_ptr<CdmHostClient>(host.release());
+    m_initCallback = WTF::move(callback);
+    m_sink = CDMWidevineEventSink::create(*this);
+    Thread::create("CDM host events"_s, [sink = Ref { *m_sink }, host = m_host]() mutable {
+        while (!sink->stop) {
+            struct pollfd fd = { host->control_fd(), POLLIN, 0 };
+            int ready = poll(&fd, 1, 200);
+            if (ready <= 0)
+                continue;
+            CdmIn event;
+            bool gone = !host->read_event(event);
+            if (gone)
+                event.type = 0; // (the host is gone: everything awaited fails)
+            callOnMainThread([sink, event = WTF::move(event)]() mutable {
+                if (sink->instance)
+                    sink->instance->handleEvent(event);
+            });
+            if (gone)
+                break;
+        }
+    })->detach();
+    if (RefPtr cdmProxy = proxy())
+        static_cast<CDMProxyOnyx&>(*cdmProxy).setHost(m_host);
+}
+
+void CDMInstanceWidevineOnyx::setServerCertificate(Ref<SharedBuffer>&& certificate, SuccessCallback&& callback)
+{
+    if (!m_host) {
+        callback(SuccessValue::Failed);
+        return;
+    }
+    uint32_t promise = addPromise([callback = WTF::move(callback)](bool resolved, const String&) mutable {
+        callback(resolved ? SuccessValue::Succeeded : SuccessValue::Failed);
+    });
+    if (!m_host->set_server_certificate(promise, toStd(certificate->span())))
+        handleEvent(*std::make_unique<CdmIn>()); // (the host is gone)
+}
