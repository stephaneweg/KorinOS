+
+// ---- the player's side ----
+
+// a packet's encryption for the host (cdm::InputBuffer_2) ; false: a scheme the module does not know
+static bool cryptOf(const av_crypt& crypt, av_us pts, CdmCrypt& out)
+{
+    switch (crypt.scheme) {
+    case 0x63656e63: // 'cenc'
+        out.scheme = Cdm::Cenc;
+        break;
+    case 0x63626373: // 'cbcs'
+        out.scheme = Cdm::Cbcs;
+        break;
+    default:
+        return false;
+    }
+    out.kid.assign(crypt.kid, crypt.kid + 16);
+    out.iv.assign(crypt.iv, crypt.iv + 16);
+    out.crypt_blocks = crypt.crypt_blocks;
+    out.skip_blocks = crypt.skip_blocks;
+    out.clear.assign(crypt.clear, crypt.clear + crypt.nsub);
+    out.cipher.assign(crypt.cipher, crypt.cipher + crypt.nsub);
+    out.timestamp = pts;
+    return true;
+}
+
+int widevineDecryptPacket(CdmHostClient& host, const av_track&, av_packet& packet)
+{
+    CdmCrypt crypt;
+    if (!packet.crypt || !cryptOf(*packet.crypt, packet.pts, crypt))
+        return AV_ERR;
+    std::vector<uint8_t> clear;
+    int status = host.decrypt(crypt, packet.data, packet.size, clear);
+    if (status == Cdm::NoKey)
+        return AV_AGAIN;
+    if (status != Cdm::Success || clear.size() != packet.size)
+        return AV_ERR;
+    memcpy(packet.data, clear.data(), clear.size());
+    free(packet.crypt);
+    packet.crypt = nullptr;
+    return AV_OK;
+}
+
+namespace {
+
+// an encrypted video track decoded by the module (av_decoder_external): the frames it gives (I420)
+struct WidevineVideo {
+    std::shared_ptr<CdmHostClient> host;
+    bool h264 { false };
+    CencTrack track;        // (H.264: its avcC, for the Annex B of each packet)
+    CdmFrame frame;         // the frame given, valid until the next call
+    bool haveFrame { false };
+    bool draining { false };
+};
+
+int widevineSend(void* context, const av_packet* packet)
+{
+    auto& video = *static_cast<WidevineVideo*>(context);
+    video.haveFrame = false;
+    if (!packet) {
+        video.draining = true; // (the frames the module still holds: empty inputs, in receive)
+        return AV_OK;
+    }
+    video.draining = false;
+    CdmCrypt crypt;
+    if (packet->crypt) {
+        if (!cryptOf(*packet->crypt, packet->pts, crypt))
+            return AV_ERR;
+    } else {
+        crypt.scheme = Cdm::Unencrypted; // (the clear start of a stream: the module decodes it too)
+        crypt.timestamp = packet->pts;
+    }
+    const uint8_t* data = packet->data;
+    size_t size = packet->size;
+    std::vector<uint8_t> annexB;
+    if (video.h264) {
+        CencSample sample;
+        sample.encrypted = packet->crypt;
+        sample.clear = crypt.clear;
+        sample.cipher = crypt.cipher;
+        if (!cenc_to_annexb(video.track, packet->data, packet->size, sample, annexB, crypt.clear, crypt.cipher))
+            return AV_ERR;
+        data = annexB.data();
+        size = annexB.size();
+    }
+    int status = video.host->decode_video(crypt, data, size, video.frame);
+    if (status == Cdm::Success)
+        video.haveFrame = true;
+    else if (status != Cdm::NeedMoreData)
+        return AV_ERR;
+    return AV_OK;
+}
+
+int widevineReceive(void* context, av_frame* out)
+{
+    auto& video = *static_cast<WidevineVideo*>(context);
+    if (!video.haveFrame && video.draining) {
+        CdmCrypt none;
+        if (video.host->decode_video(none, nullptr, 0, video.frame) == Cdm::Success)
+            video.haveFrame = true;
+        else
+            video.draining = false;
+    }
+    if (!video.haveFrame)
+        return AV_AGAIN;
+    video.haveFrame = false;
+    const CdmFrame& frame = video.frame;
+    if ((frame.format != Cdm::I420 && frame.format != Cdm::Yv12) || !frame.width || !frame.height)
+        return AV_AGAIN;
+    // (the offsets are the Y, U and V planes' whatever their order in memory)
+    for (int plane = 0; plane < 3; plane++) {
+        size_t rows = plane ? (frame.height + 1) / 2 : frame.height;
+        if (frame.offset[plane] + (rows - 1) * frame.stride[plane] + (plane ? (frame.width + 1) / 2 : frame.width) > frame.pixels.size())
+            return AV_AGAIN;
+    }
+    memset(out, 0, sizeof *out);
+    out->kind = AV_VIDEO;
+    out->pts = frame.timestamp;
+    out->pix = AV_PIX_I420;
+    out->width = frame.width;
+    out->height = frame.height;
+    for (int plane = 0; plane < 3; plane++) {
+        out->plane[plane] = const_cast<uint8_t*>(frame.pixels.data()) + frame.offset[plane];
+        out->stride[plane] = frame.stride[plane];
+    }
+    out->colorspace = frame.height >= 720 ? AV_CS_BT709 : AV_CS_BT601;
+    return AV_OK;
+}
+
+void widevineFlush(void* context)
+{
+    auto& video = *static_cast<WidevineVideo*>(context);
+    video.haveFrame = false;
+    video.draining = false;
+    video.host->reset_video();
+}
+
+void widevineClose(void* context)
+{
+    auto* video = static_cast<WidevineVideo*>(context);
+    video->host->reset_video();
+    delete video;
+}
+
+const av_decoder_ops widevineOps = { "widevine", widevineSend, widevineReceive, widevineFlush, widevineClose };
+
+} // namespace
+
+av_decoder* widevineVideoDecoder(std::shared_ptr<CdmHostClient> host, const av_track& track)
+{
+    uint32_t codec, profile;
+    std::vector<uint8_t> extra;
+    if (track.extra && track.extra_len)
+        extra.assign(track.extra, track.extra + track.extra_len);
+    switch (track.codec) {
+    case AV_C_H264: {
+        codec = Cdm::CodecH264;
+        int idc = extra.size() > 1 ? extra[1] : 100;
+        profile = idc == 66 ? Cdm::H264Baseline : idc == 77 ? Cdm::H264Main : idc == 88 ? Cdm::H264Extended
+            : idc == 110 ? Cdm::H264High10 : idc == 122 ? Cdm::H264High422 : idc == 244 ? Cdm::H264High444 : Cdm::H264High;
+        break;
+    }
+    case AV_C_VP9:
+        codec = Cdm::CodecVp9;
+        profile = Cdm::Vp9Profile0;
+        break;
+    case AV_C_VP8:
+        codec = Cdm::CodecVp8;
+        profile = Cdm::ProfileNotNeeded;
+        break;
+    case AV_C_AV1:
+        codec = Cdm::CodecAv1;
+        profile = Cdm::Av1Main;
+        break;
+    default:
+        return nullptr;
+    }
+    if (!host || host->init_video(codec, profile, track.width, track.height, extra) != Cdm::Success) {
+        WTFLogAlways("Widevine: the module does not decode this video (%s, %dx%d)", track.codec_str, track.width, track.height);
+        return nullptr;
+    }
+    auto* video = new WidevineVideo;
+    video->host = WTF::move(host);
+    video->h264 = codec == Cdm::CodecH264;
+    video->track.avcc = extra;
+    video->track.width = track.width;
+    video->track.height = track.height;
+    av_decoder* decoder = av_decoder_external(&widevineOps, video);
+    if (!decoder) {
+        video->host->reset_video();
+        delete video;
+    }
+    return decoder;
+}
