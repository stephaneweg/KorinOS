+// the values of Google's content_decryption_module.h (cdm::) that go through cdmhost's protocol
+namespace Cdm {
+enum : uint32_t { Success = 0, NeedMoreData = 1, NoKey = 2 };
+enum : uint32_t { Unencrypted = 0, Cenc = 1, Cbcs = 2 };
+enum : uint32_t { CodecVp8 = 1, CodecH264 = 2, CodecVp9 = 3, CodecAv1 = 4 };
+enum : uint32_t { ProfileNotNeeded = 1, H264Baseline = 2, H264Main = 3, H264Extended = 4, H264High = 5, H264High10 = 6,
