+unsigned av__store_track_cfg(struct av_store *s, int src, int track)
+{
+	struct source *so = get(s, src);
+	return so != NULL && so->queue && track >= 0 && track < AV_MAX_TRACKS ? so->qcfg[track] : 0;
+}
+
+const struct av_track *av__store_track_info_cfg(struct av_store *s, int src, int track, unsigned cfg)
+{
+	struct source *so = get(s, src);
+	int h = (int) (cfg % NCFG);
+
+	if (so == NULL)
+		return NULL;
+	if (so->queue && track >= 0 && track < AV_MAX_TRACKS && so->qhist_set[track][h] && so->qhist_cfg[track][h] == cfg)
+		return &so->qhist[track][h];
+	return so_track(so, track);
+}
+
+int av__store_take_removed(struct av_store *s, int src, int track, av_us *dts)
+{
+	struct source *so = get(s, src);
+	struct strack *t;
+
+	if (so == NULL || track < 0 || track >= AV_MAX_TRACKS)
+		return 0;
+	t = &so->tr[track];
+	if (!t->removed)
+		return 0;
+	*dts = t->removed_dts;
+	t->removed = 0;
+	return 1;
+}
