 typedef int (*av_decrypt_fn)(void *ctx, const struct av_track *t, struct av_packet *p);
 void av_player_set_decryptor(struct av_player *p, av_decrypt_fn fn, void *ctx);
+/* EME: the host's decoders for encrypted tracks (a CDM that decodes itself: Widevine's video, which never leaves
+ * it in the clear) : called by the player's threads when such a track starts -> av_decoder_external (), NULL : the
+ * built-in decoder (after the decryptor). The decryptor may then leave p->crypt set (AV_OK): the decoder takes it. */
+typedef struct av_decoder *(*av_decoder_factory)(void *ctx, const struct av_track *t);
+void av_player_set_decoder_factory(struct av_player *p, av_decoder_factory fn, void *ctx);
 /* The host's turn (its UI thread, every ~10-30 ms while playing): the status, and the video
  * frame to show now if a new one is due (*v filled, returns 1). */
