+/* EME: a decoder given by the host (a CDM that decrypts and decodes, Widevine's video): its calls, its context
+ * (close () frees it); the packets keep their p->crypt */
+struct av_decoder_ops {
+	const char *name;
+	int (*send)(void *c, const struct av_packet *p);	/* p NULL: drain */
+	int (*receive)(void *c, struct av_frame *f);
+	void (*flush)(void *c);
+	void (*close)(void *c);
+};
+struct av_decoder *av_decoder_external(const struct av_decoder_ops *ops, void *c);
 /* 1 if this build decodes the track (its codec, FFmpeg's ff_id; encrypted: once decrypted) */
 int av_decoder_supported_track(const struct av_track *t);
 void av_decoder_free(struct av_decoder *d);
@@ -377,6 +387,11 @@
