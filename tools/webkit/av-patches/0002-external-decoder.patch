+struct av_decoder *av_decoder_external(const struct av_decoder_ops *ops, void *c)
+{
+	/* (the decoder and its own table in one block: av_decoder_free frees both) */
+	struct ext {
+		struct av_decoder d;
+		struct av_codec_impl impl;
+	} *e;
+
+	if (ops == NULL || c == NULL || (e = (struct ext *) calloc(1, sizeof *e)) == NULL)
+		return NULL;
+	e->impl.name = ops->name ? ops->name : "external";
+	e->impl.library = "host";
+	e->impl.send = ops->send;
+	e->impl.receive = ops->receive;
+	e->impl.flush = ops->flush;
+	e->impl.close = ops->close;
+	e->d.impl = &e->impl;
+	e->d.c = c;
+	return &e->d;
+}
