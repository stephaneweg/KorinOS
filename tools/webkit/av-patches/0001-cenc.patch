diff -ruN a/av/av_crypt.c b/av/av_crypt.c
--- a/av/av_crypt.c	1970-01-01 01:00:00.000000000 +0100
+++ b/av/av_crypt.c	2026-11-19 23:43:32.348834300 +0100
@@ -0,0 +1,272 @@
+/*
+ * av_crypt.c -- Common Encryption (ISO/IEC 23001-7, the formats of EME): a packet's encryption
+ * (struct av_crypt, filled by the MP4 demuxer from tenc / senc) and its decryption with a known key
+ * (av_decrypt: EME's Clear Key; a CDM such as Widevine decrypts on its side).
+ *
+ *   'cenc'  AES-128 CTR; the counter block is the IV (8-byte IVs: zero-padded), incremented as a 128-bit
+ *           big-endian number across the encrypted bytes of all the subsamples, one keystream
+ *   'cens'  the same with a pattern (crypt / skip blocks)
+ *   'cbcs'  AES-128 CBC with a pattern (crypt blocks encrypted, skip blocks clear, from each subsample's
+ *           start), the IV restarting at each subsample; a partial block at a subsample's end is clear
+ *   'cbc1'  AES-128 CBC over the whole encrypted ranges, the chain carried across subsamples
+ *
+ * AES-128 here, small and plain (the library has no other dependency): enough for audio and the
+ * modest video EME Clear Key carries.
+ */
+#include <stdlib.h>
+#include <string.h>
+#include "av_int.h"
+
+#define FOURCC(a, b, c, d) ((uint32_t) (a) << 24 | (uint32_t) (b) << 16 | (uint32_t) (c) << 8 | (uint32_t) (d))
+
+struct av_crypt *av_crypt_new(int nsub)
+{
+	size_t n = sizeof (struct av_crypt) + (size_t) (nsub > 0 ? nsub : 0) * 2 * sizeof (uint32_t);
+	struct av_crypt *c = (struct av_crypt *) calloc(1, n);
+
+	if (c == NULL)
+		return NULL;
+	c->nsub = nsub > 0 ? nsub : 0;
+	c->clear = (uint32_t *) (c + 1);
+	c->cipher = c->clear + c->nsub;
+	return c;
+}
+
+struct av_crypt *av_crypt_dup(const struct av_crypt *c)
+{
+	struct av_crypt *d;
+
+	if (c == NULL || (d = av_crypt_new(c->nsub)) == NULL)
+		return NULL;
+	{
+		uint32_t *cl = d->clear, *ci = d->cipher;
+		*d = *c;
+		d->clear = cl;
+		d->cipher = ci;
+	}
+	memcpy(d->clear, c->clear, (size_t) c->nsub * sizeof (uint32_t));
+	memcpy(d->cipher, c->cipher, (size_t) c->nsub * sizeof (uint32_t));
+	return d;
+}
+
+/* ---- AES-128 ------------------------------------------------------------------------------- */
+
+static const uint8_t sbox[256] = {
+	0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
+	0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
+	0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
+	0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
+	0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
+	0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
+	0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
+	0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
+	0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
+	0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
+	0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
+	0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
+	0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
+	0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
+	0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
+	0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
+};
+
+static uint8_t rsbox[256];
+
+static uint8_t xt(uint8_t x) { return (uint8_t) ((x << 1) ^ ((x >> 7) * 0x1b)); }
+
+static uint8_t mul(uint8_t a, uint8_t b)
+{
+	uint8_t r = 0;
+	while (b) {
+		if (b & 1)
+			r ^= a;
+		a = xt(a);
+		b >>= 1;
+	}
+	return r;
+}
+
+struct aes { uint8_t rk[176]; };
+
+static void aes_init(struct aes *a, const uint8_t key[16])
+{
+	static const uint8_t rcon[10] = { 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36 };
+	int i;
+
+	if (rsbox[sbox[1]] != 1)	/* (the inverse table, once; any thread computes the same bytes) */
+		for (i = 0; i < 256; i++)
+			rsbox[sbox[i]] = (uint8_t) i;
+	memcpy(a->rk, key, 16);
+	for (i = 16; i < 176; i += 4) {
+		uint8_t t[4];
+		memcpy(t, a->rk + i - 4, 4);
+		if (i % 16 == 0) {
+			uint8_t u = t[0];
+			t[0] = (uint8_t) (sbox[t[1]] ^ rcon[i / 16 - 1]);
+			t[1] = sbox[t[2]];
+			t[2] = sbox[t[3]];
+			t[3] = sbox[u];
+		}
+		a->rk[i] = a->rk[i - 16] ^ t[0];
+		a->rk[i + 1] = a->rk[i - 15] ^ t[1];
+		a->rk[i + 2] = a->rk[i - 14] ^ t[2];
+		a->rk[i + 3] = a->rk[i - 13] ^ t[3];
+	}
+}
+
+static void aes_encrypt(const struct aes *a, const uint8_t in[16], uint8_t out[16])
+{
+	uint8_t s[16], t[16];
+	int r, c, i;
+
+	for (i = 0; i < 16; i++)
+		s[i] = in[i] ^ a->rk[i];
+	for (r = 1; r <= 10; r++) {
+		/* SubBytes and ShiftRows (column-major state: s[4c + row]) */
+		for (c = 0; c < 4; c++)
+			for (i = 0; i < 4; i++)
+				t[4 * c + i] = sbox[s[4 * ((c + i) & 3) + i]];
+		if (r < 10)
+			for (c = 0; c < 4; c++) {
+				uint8_t *q = t + 4 * c, a0 = q[0], a1 = q[1], a2 = q[2], a3 = q[3], x = a0 ^ a1 ^ a2 ^ a3;
+				q[0] ^= x ^ xt(a0 ^ a1);
+				q[1] ^= x ^ xt(a1 ^ a2);
+				q[2] ^= x ^ xt(a2 ^ a3);
+				q[3] ^= x ^ xt(a3 ^ a0);
+			}
+		for (i = 0; i < 16; i++)
+			s[i] = t[i] ^ a->rk[16 * r + i];
+	}
+	memcpy(out, s, 16);
+}
+
+static void aes_decrypt(const struct aes *a, const uint8_t in[16], uint8_t out[16])
+{
+	uint8_t s[16], t[16];
+	int r, c, i;
+
+	for (i = 0; i < 16; i++)
+		s[i] = in[i] ^ a->rk[160 + i];
+	for (r = 9; r >= 0; r--) {
+		/* InvShiftRows and InvSubBytes */
+		for (c = 0; c < 4; c++)
+			for (i = 0; i < 4; i++)
+				t[4 * ((c + i) & 3) + i] = rsbox[s[4 * c + i]];
+		for (i = 0; i < 16; i++)
+			t[i] ^= a->rk[16 * r + i];
+		if (r > 0)
+			for (c = 0; c < 4; c++) {
+				uint8_t *q = t + 4 * c, a0 = q[0], a1 = q[1], a2 = q[2], a3 = q[3];
+				q[0] = mul(a0, 14) ^ mul(a1, 11) ^ mul(a2, 13) ^ mul(a3, 9);
+				q[1] = mul(a0, 9) ^ mul(a1, 14) ^ mul(a2, 11) ^ mul(a3, 13);
+				q[2] = mul(a0, 13) ^ mul(a1, 9) ^ mul(a2, 14) ^ mul(a3, 11);
+				q[3] = mul(a0, 11) ^ mul(a1, 13) ^ mul(a2, 9) ^ mul(a3, 14);
+			}
+		memcpy(s, t, 16);
+	}
+	memcpy(out, s, 16);
+}
+
+/* ---- the schemes ---------------------------------------------------------------------------- */
+
+struct ctr {
+	const struct aes *a;
+	uint8_t counter[16], ks[16];
+	int used;		/* bytes of ks already used (16: a new block is due) */
+};
+
+static void ctr_xor(struct ctr *c, uint8_t *p, size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++) {
+		if (c->used == 16) {
+			int k;
+			aes_encrypt(c->a, c->counter, c->ks);
+			for (k = 15; k >= 0 && ++c->counter[k] == 0; k--)
+				;
+			c->used = 0;
+		}
+		p[i] ^= c->ks[c->used++];
+	}
+}
+
+/* CBC decryption of whole blocks of p (n a multiple of 16), the chain in iv (updated) */
+static void cbc_blocks(const struct aes *a, uint8_t *p, size_t n, uint8_t iv[16])
+{
+	uint8_t prev[16], cur[16];
+	size_t i;
+	int k;
+
+	memcpy(prev, iv, 16);
+	for (i = 0; i + 16 <= n; i += 16) {
+		memcpy(cur, p + i, 16);
+		aes_decrypt(a, cur, p + i);
+		for (k = 0; k < 16; k++)
+			p[i + k] ^= prev[k];
+		memcpy(prev, cur, 16);
+	}
+	memcpy(iv, prev, 16);
+}
+
+/* one encrypted range of a subsample: with a pattern, crypt blocks then skip blocks (clear) */
+static void range_decrypt(const struct aes *a, uint32_t scheme, const struct av_crypt *c, uint8_t *p, size_t n,
+		struct ctr *ct, uint8_t iv[16])
+{
+	int pattern = c->crypt_blocks > 0;
+	size_t crypt = pattern ? (size_t) c->crypt_blocks * 16 : n, skip = pattern ? (size_t) c->skip_blocks * 16 : 0;
+	size_t i = 0;
+
+	while (i < n) {
+		size_t k = n - i < crypt ? n - i : crypt;
+		if (scheme == FOURCC('c','e','n','c') || scheme == FOURCC('c','e','n','s'))
+			ctr_xor(ct, p + i, pattern ? k - k % 16 : k);
+		else
+			cbc_blocks(a, p + i, k - k % 16, iv);	/* (a partial last block: clear) */
+		i += k;
+		if (!pattern)
+			break;
+		i += skip;
+	}
+}
+
+int av_decrypt(struct av_packet *p, const uint8_t key[16])
+{
+	const struct av_crypt *c = p->crypt;
+	struct aes a;
+	struct ctr ct;
+	uint8_t iv[16];
+	uint32_t scheme;
+	size_t off = 0;
+	int i;
+
+	if (c == NULL)
+		return AV_OK;
+	scheme = c->scheme ? c->scheme : FOURCC('c','e','n','c');
+	if (scheme != FOURCC('c','e','n','c') && scheme != FOURCC('c','e','n','s') && scheme != FOURCC('c','b','c','s') &&
+	    scheme != FOURCC('c','b','c','1'))
+		return AV_EUNSUP;
+	aes_init(&a, key);
+	ct.a = &a;
+	memcpy(ct.counter, c->iv, 16);
+	ct.used = 16;
+	memcpy(iv, c->iv, 16);
+	if (c->nsub == 0) {
+		range_decrypt(&a, scheme, c, p->data, p->size, &ct, iv);
+	} else {
+		for (i = 0; i < c->nsub; i++) {
+			size_t cl = c->clear[i], ci = c->cipher[i];
+			if (off + cl + ci > p->size)
+				return AV_ERR;
+			off += cl;
+			if (scheme == FOURCC('c','b','c','s'))
+				memcpy(iv, c->iv, 16);	/* (cbcs: the IV restarts at each subsample) */
+			range_decrypt(&a, scheme, c, p->data + off, ci, &ct, iv);
+			off += ci;
+		}
+	}
+	memset(&a, 0, sizeof a);
+	free(p->crypt);
+	p->crypt = NULL;
+	return AV_OK;
+}
