@@ -31,8 +31,45 @@
 using namespace muse;
 using namespace muse::audio::synth;
 
+#ifdef __armpi__
+#include "korinaudiokit.h"
+#include <cstdint>
+#include <cstring>
+#endif
+
 RetVal<SoundFontMeta> FluidSoundFontParser::parseSoundFont(const SoundFontPath& path)
 {
+#ifdef __armpi__
+    // Korin OS : une seule SoundFont, celle du système qu'AudioKit joue (ak_sf_default) ; ses presets, sous le nom
+    // « MS Basic » que MuseScore prend par défaut (et que citent les partitions)
+    {
+        const auto& ak = muse::audio::korin::AudioKit::get();
+        const long sf = ak.ok() ? ak.sf_default() : 0;
+        SoundFontMeta meta;
+        meta.name = "MS Basic";
+        meta.path = path;
+        const long n = sf > 0 && ak.sf_presets ? ak.sf_presets(sf) : 0;
+        for (long i = 0; i < n; ++i) {
+            unsigned char buf[muse::audio::korin::AudioKit::AKSP_SIZE] = {};
+            if (ak.sf_preset(sf, i, buf) < 0) {
+                continue;
+            }
+            uint32_t bank = 0, program = 0;
+            std::memcpy(&bank, buf + muse::audio::korin::AudioKit::AKSP_BANK, 4);
+            std::memcpy(&program, buf + muse::audio::korin::AudioKit::AKSP_PROGRAM, 4);
+            const char* name = reinterpret_cast<const char*>(buf + muse::audio::korin::AudioKit::AKSP_NAME);
+            if (!std::strcmp(name, "EOP")) {
+                continue;	// (la fin de la liste des presets du fichier)
+            }
+            SoundFontPreset preset;
+            preset.program = midi::Program(bank, program);
+            preset.name = name;
+            meta.presets.emplace_back(std::move(preset));
+        }
+        return RetVal<SoundFontMeta>::make_ok(meta);
+    }
+#endif
+
     fluid_settings_t* settings = nullptr;
     fluid_sfloader_t* loader = nullptr;
     fluid_sfont_t* sfont = nullptr;
