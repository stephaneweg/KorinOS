diff --git a/src/app/main.cpp b/src/app/main.cpp
index 2ac78a89..77983e5e 100644
--- a/src/app/main.cpp
+++ b/src/app/main.cpp
@@ -57,6 +57,46 @@ static void crashCallback(int signum)
 
 #endif
 
+#ifdef Q_OS_KORIN
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+// Korin OS : la langue du système (lang = xx de /etc/system.ini, fr sans clé, comme UIKit) dans LANG, avant Qt :
+// sans elle, QLocale ne voit que « C » et MuseScore reste en anglais
+static void korin_set_lang()
+{
+    // (une langue déjà dite est gardée ; « C » et « POSIX », la valeur par défaut d'une session, n'en sont pas)
+    const char* cur = getenv("LANG");
+    if (cur && *cur && strcmp(cur, "C") && strcmp(cur, "POSIX") && strncmp(cur, "C.", 2)) {
+        return;
+    }
+    char lang[16] = "fr";
+    if (FILE* f = fopen("/etc/system.ini", "r")) {
+        char line[256];
+        while (fgets(line, sizeof line, f)) {
+            char v[16];
+            if (sscanf(line, " lang = %15[A-Za-z_]", v) == 1) {
+                strcpy(lang, v);
+            }
+        }
+        fclose(f);
+    }
+    // fr -> fr_FR.UTF-8, en -> en_US.UTF-8, pt_BR -> pt_BR.UTF-8
+    char value[40];
+    if (strchr(lang, '_')) {
+        snprintf(value, sizeof value, "%s.UTF-8", lang);
+    } else {
+        const char* region = !strcmp(lang, "en") ? "US" : lang;
+        char up[8] = {};
+        for (int i = 0; region[i] && i < 7; i++) {
+            up[i] = (region[i] >= 'a' && region[i] <= 'z') ? char(region[i] - 'a' + 'A') : region[i];
+        }
+        snprintf(value, sizeof value, "%s_%s.UTF-8", lang, up);
+    }
+    setenv("LANG", value, 1);
+}
+#endif
+
