diff --git a/src/compiler/hlp.bas b/src/compiler/hlp.bas
index 12e4bb9..9804fb2 100644
--- a/src/compiler/hlp.bas
+++ b/src/compiler/hlp.bas
@@ -370,6 +370,26 @@ function pathStripDiv( byref path as string ) as string
 	function = path
 end function
 
+#ifdef __FB_ARMPI__
+'' /... or VOL:/... (getcwd gives the second) : the length of the root, 0 if relative
+function hArmpiRootLen( byval path as zstring ptr ) as integer
+	if( (*path)[0] = asc( "/" ) ) then
+		return 1
+	end if
+	dim as integer i = 0
+	while( ((*path)[i] <> 0) and ((*path)[i] <> asc( "/" )) )
+		if( (*path)[i] = asc( ":" ) ) then
+			if( (i > 0) and ((*path)[i + 1] = asc( "/" )) ) then
+				return i + 2
+			end if
+			exit while
+		end if
+		i += 1
+	wend
+	return 0
+end function
+#endif
+
 function pathIsAbsolute( byval path as zstring ptr ) as integer
 #if defined( __FB_WIN32__ ) or defined( __FB_DOS__ )
 	if( (*path)[0] <> 0 ) then
@@ -384,6 +404,8 @@ function pathIsAbsolute( byval path as zstring ptr ) as integer
 #endif
 		end select
 	end if
+#elseif defined( __FB_ARMPI__ )
+	function = (hArmpiRootLen( path ) > 0)
 #else
 	'' /...
 	function = ((*path)[0] = asc( "/" ))
