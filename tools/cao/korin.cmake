# korin.cmake : fichier de chaîne CMake de la CAO (OCCT) pour Korin, sur libposix du dépôt (build/pc/posix pour le
# PC, build/posix pour le Pi). Variables d'environnement : ARCH (x86_64, aarch64), KORIN_ROOT, KORIN_POSIX.
# CMake voit un « Linux » (UNIX), mais __linux__ n'est pas défini : le code tiers prend ses chemins POSIX génériques.
set(CMAKE_SYSTEM_NAME Linux)
set(KORIN_ARCH "$ENV{ARCH}")
if(NOT KORIN_ARCH)
	set(KORIN_ARCH x86_64)
endif()
set(CMAKE_SYSTEM_PROCESSOR ${KORIN_ARCH})
if(DEFINED ENV{KORIN_TOOLCHAINS})
	set(_tc "$ENV{KORIN_TOOLCHAINS}/${KORIN_ARCH}-onyx-elf-14.2/bin/${KORIN_ARCH}-onyx-elf-")
else()
	set(_tc "/opt/toolchains/${KORIN_ARCH}-onyx-elf-14.2/bin/${KORIN_ARCH}-onyx-elf-")
endif()
set(KORIN_POSIX "$ENV{KORIN_POSIX}")
if(KORIN_ARCH STREQUAL "aarch64")
	set(_cpu "-mcpu=cortex-a72 ")
else()
	set(_cpu "")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES KORIN_POSIX KORIN_ARCH)

set(CMAKE_C_COMPILER ${_tc}gcc)
set(CMAKE_CXX_COMPILER ${_tc}g++)
set(CMAKE_AR ${_tc}ar CACHE FILEPATH "")
set(CMAKE_RANLIB ${_tc}ranlib CACHE FILEPATH "")
set(CMAKE_STRIP ${_tc}strip CACHE FILEPATH "")
set(_flags "${_cpu}-specs=${KORIN_POSIX}/lib/posix.specs -D_GNU_SOURCE -DFD_SETSIZE=1024 -ffunction-sections -fdata-sections")
set(CMAKE_C_FLAGS_INIT "${_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_cpu}-specs=${KORIN_POSIX}/lib/posix.specs")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "")

set(CMAKE_FIND_ROOT_PATH "${KORIN_POSIX}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
