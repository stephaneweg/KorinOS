# config-gui.cmake : cache initial de Blender pour Korin PC, jalon 3 (docs/etude/BLENDER.md) : l'interface, GHOST de
# Korin sur UIKit (tools/blender/ghost), dessin par Vulkan (VkKit) ; le reste comme config-headless.cmake : d'après build_files/cmake/config/blender_lite.cmake, avec ce qui
# ne demande pas de bibliothèque de plus remis en marche. Lu par tools/blender/build.sh (cmake -C).

# L'interface : GHOST de Korin (UIKit), Vulkan seul
set(WITH_HEADLESS            OFF CACHE BOOL "" FORCE)
set(WITH_GHOST_KORIN         ON  CACHE BOOL "" FORCE)
set(WITH_VULKAN_BACKEND      ON  CACHE BOOL "" FORCE)
set(WITH_OPENGL_BACKEND      OFF CACHE BOOL "" FORCE)
set(WITH_GHOST_X11           OFF CACHE BOOL "" FORCE)
set(WITH_GHOST_WAYLAND       OFF CACHE BOOL "" FORCE)
set(WITH_GHOST_SDL           OFF CACHE BOOL "" FORCE)
set(WITH_XR_OPENXR           OFF CACHE BOOL "" FORCE)
set(WITH_INPUT_IME           OFF CACHE BOOL "" FORCE)
set(WITH_INPUT_NDOF          OFF CACHE BOOL "" FORCE)
set(WITH_RENDERDOC           OFF CACHE BOOL "" FORCE)

# La construction
set(WITH_LIBS_PRECOMPILED    OFF CACHE BOOL "" FORCE)
set(WITH_STATIC_LIBS         ON  CACHE BOOL "" FORCE)
set(WITH_INSTALL_PORTABLE    ON  CACHE BOOL "" FORCE)
set(WITH_CPU_CHECK           OFF CACHE BOOL "" FORCE)
set(WITH_LINKER_LLD          OFF CACHE BOOL "" FORCE)
