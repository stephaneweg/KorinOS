diff --git a/src/control/keyboard_manager.cpp b/src/control/keyboard_manager.cpp
index 6264076..ce03cf2 100644
--- a/src/control/keyboard_manager.cpp
+++ b/src/control/keyboard_manager.cpp
@@ -186,6 +186,13 @@ KeyboardManager::process_menu_key_event(const SDL_KeyboardEvent& event)
   }
 
   Control control;
+  /* les touches A et B du PocketTerm, par leur place, comme en jeu */
+  if (event.keysym.scancode == SDL_SCANCODE_A || event.keysym.scancode == SDL_SCANCODE_B)
+  {
+    control = event.keysym.scancode == SDL_SCANCODE_A ? Control::MENU_SELECT : Control::ESCAPE;
+    m_parent->get_controller().set_control(control, (event.type == SDL_KEYDOWN));
+    return;
+  }
   /* we use default keys when the menu is open (to avoid problems when
    * redefining keys to invalid settings
    */
