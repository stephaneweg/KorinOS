+#ifdef __armpi__
+// ARMPI n'a pas de fork : posix_spawn. Les bouts du fils partent sur 0, 1, 2 (adddup2).
+#include <spawn.h>
+static pthread_mutex_t s_armpiSpawnLock = PTHREAD_MUTEX_INITIALIZER;
+
+static int32_t ArmpiSpawn(const char* filename, char* const argv[], char* const envp[], const char* cwd,
+                          int32_t redirectStdin, int32_t redirectStdout, int32_t redirectStderr,
+                          int32_t* childPid, int32_t* stdinFd, int32_t* stdoutFd, int32_t* stderrFd)
+{
+    int inFds[2] = {-1, -1}, outFds[2] = {-1, -1}, errFds[2] = {-1, -1};
+    if ((redirectStdin && pipe2(inFds, O_CLOEXEC) != 0) || (redirectStdout && pipe2(outFds, O_CLOEXEC) != 0) ||
+        (redirectStderr && pipe2(errFds, O_CLOEXEC) != 0))
+    {
+        return -1;
+    }
+    posix_spawn_file_actions_t fa;
+    posix_spawn_file_actions_init(&fa);
+    if (redirectStdin) posix_spawn_file_actions_adddup2(&fa, inFds[0], 0);
+    if (redirectStdout) posix_spawn_file_actions_adddup2(&fa, outFds[1], 1);
+    if (redirectStderr) posix_spawn_file_actions_adddup2(&fa, errFds[1], 2);
+    char old[512];
+    old[0] = 0;
+    pthread_mutex_lock(&s_armpiSpawnLock);  // (le dossier du fils est celui du pere au lancement)
+    if (cwd != NULL && (getcwd(old, sizeof(old)) == NULL || chdir(cwd) != 0))
+    {
+        old[0] = 0;
+    }
+    pid_t pid = -1;
+    int err = posix_spawn(&pid, filename, &fa, NULL, argv, envp);
+    if (old[0] != 0)
+    {
+        (void)! chdir(old);
+    }
+    pthread_mutex_unlock(&s_armpiSpawnLock);
+    posix_spawn_file_actions_destroy(&fa);
+    if (inFds[0] >= 0) close(inFds[0]);
+    if (outFds[1] >= 0) close(outFds[1]);
+    if (errFds[1] >= 0) close(errFds[1]);
