diff --git a/src/native/corehost/apphost/static/armpihost.cpp b/src/native/corehost/apphost/static/armpihost.cpp
new file mode 100755
index 000000000..a525aceb8
--- /dev/null
+++ b/src/native/corehost/apphost/static/armpihost.cpp
@@ -0,0 +1,152 @@
+// armpihost.cpp -- l'hote des programmes C# d'ARMPI quand l'executable ne porte pas de bundle :
+//     /dotnet/dotnet app.dll [arguments]
+// Pas de hostfxr, ni de .deps.json : les assemblys sont ceux du dossier de app.dll, puis ceux de
+// /dotnet (le runtime partage). Tout le natif est dans l'executable : PINVOKE_OVERRIDE, pas de dlopen.
+#include <dirent.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+#include <string>
+#include <unistd.h>
+
+extern "C"
+{
+    int coreclr_initialize(const char* exePath, const char* appDomainFriendlyName, int propertyCount,
+                           const char** propertyKeys, const char** propertyValues, void** hostHandle,
+                           unsigned int* domainId);
+    int coreclr_execute_assembly(void* hostHandle, unsigned int domainId, int argc, const char** argv,
+                                 const char* managedAssemblyPath, unsigned int* exitCode);
+    int coreclr_shutdown_2(void* hostHandle, unsigned int domainId, int* latchedExitCode);
+
+    const void* CompressionResolveDllImport(const char* name);
+    const void* SystemResolveDllImport(const char* name);
+    const void* CryptoResolveDllImport(const char* name);
+}
+
+static const char s_root[] = "/dotnet";
+
+// fn (args[0..7]) ; results[0..3] <- x0..x3 : les kits rendent plusieurs registres, le C# n'en lit qu'un
+__asm__(".text\n.globl armpi_call\n.type armpi_call, %function\narmpi_call:\n"
+        "\tstp x29, x30, [sp, -32]!\n\tmov x29, sp\n\tstr x19, [sp, 16]\n\tmov x19, x2\n"
+        "\tmov x16, x0\n\tmov x9, x1\n\tldp x0, x1, [x9]\n\tldp x2, x3, [x9, 16]\n"
+        "\tldp x4, x5, [x9, 32]\n\tldp x6, x7, [x9, 48]\n\tblr x16\n"
+        "\tstp x0, x1, [x19]\n\tstp x2, x3, [x19, 16]\n"
+        "\tldr x19, [sp, 16]\n\tldp x29, x30, [sp], 32\n\tret\n");
+
+extern "C"
+{
+    void armpi_call(void* fn, long* args, long* results);
+    void* armpi_kit_open(const char* name, unsigned min_version);
+    void* armpi_kit_fn(const void* kit, unsigned rank);
+}
+
+// « libarmpi » des DLL C# : System.Kits.KitLoader
+extern "C" const void* ArmpiResolveDllImport(const char* name)
+{
+    if (strcmp(name, "armpi_kit_open") == 0)
+        return (const void*)armpi_kit_open;
+    if (strcmp(name, "armpi_kit_fn") == 0)
+        return (const void*)armpi_kit_fn;
+    if (strcmp(name, "armpi_call") == 0)
+        return (const void*)armpi_call;
+    return nullptr;
+}
+
+static const void* armpi_pinvoke_override(const char* library, const char* entry)
+{
+    if (strcmp(library, "libarmpi") == 0)
+        return ArmpiResolveDllImport(entry);
+    if (strcmp(library, "libSystem.Native") == 0)
+        return SystemResolveDllImport(entry);
+    if (strcmp(library, "libSystem.Security.Cryptography.Native.OpenSsl") == 0)
+        return CryptoResolveDllImport(entry);
+    if (strcmp(library, "libSystem.IO.Compression.Native") == 0)
+        return CompressionResolveDllImport(entry);
+    return nullptr;
+}
+
+// les *.dll de dir, a la suite de tpa
+static void add_dlls(std::string& tpa, const std::string& dir)
+{
+    DIR* d = opendir(dir.c_str());
+    if (d == nullptr)
+        return;
+    while (dirent* e = readdir(d))
+    {
+        size_t n = strlen(e->d_name);
+        if (n < 5 || strcasecmp(e->d_name + n - 4, ".dll") != 0)
+            continue;
+        if (!tpa.empty())
+            tpa += ':';
+        tpa += dir;
+        tpa += '/';
+        tpa += e->d_name;
+    }
+    closedir(d);
+}
+
+void armpi_host_defaults()
+{
+    setenv("DOTNET_EnableWriteXorExecute", "0", 0);	// (W^X mappe le code deux fois)
+    setenv("DOTNET_GCHeapHardLimit", "40000000", 0);	// (reservation dans l'arene de 64 Go)
+    setenv("DOTNET_TieredPGO", "0", 0);
+    setenv("DOTNET_gcConcurrent", "0", 0);
+}
+
+int armpi_host_main(int argc, const char* argv[])
+{
+    if (argc < 2)
+    {
+        fprintf(stderr, "usage : dotnet app.dll [arguments]\n");
+        return 1;
+    }
+    char app[PATH_MAX];
+    if (realpath(argv[1], app) == nullptr)
+    {
+        fprintf(stderr, "dotnet : %s introuvable\n", argv[1]);
+        return 1;
+    }
+    // (« : » separe les assemblys de TRUSTED_PLATFORM_ASSEMBLIES ; le volume par defaut suffit)
+    const char* colon = strstr(app, ":/");
+    std::string dir(colon != nullptr ? colon + 1 : app);
+    std::string path(dir);
+    size_t slash = dir.rfind('/');
+    dir = slash == std::string::npos ? std::string(".") : dir.substr(0, slash);
+
+    std::string tpa;
+    add_dlls(tpa, dir);
+    add_dlls(tpa, s_root);
+
+    char over[32];
+    snprintf(over, sizeof over, "0x%lx", (unsigned long)&armpi_pinvoke_override);
+    std::string base = dir + "/";
+    const char* keys[] = {
+        "TRUSTED_PLATFORM_ASSEMBLIES", "APP_PATHS", "APP_CONTEXT_BASE_DIRECTORY", "PINVOKE_OVERRIDE",
+        "RUNTIME_IDENTIFIER", "System.Globalization.Invariant", "System.GC.Concurrent",
+        "System.Diagnostics.Tracing.EventSource.IsSupported", "UseSystemResourceKeys",
+    };
+    const char* values[] = {
+        tpa.c_str(), dir.c_str(), base.c_str(), over,
+        "linux-arm64", "true", "false",
+        "false", "true",
+    };
+    void* host;
+    unsigned int domain;
+    int hr = coreclr_initialize("/dotnet/dotnet", "app", sizeof keys / sizeof keys[0], keys, values, &host, &domain);
+    if (hr < 0)
+    {
+        fprintf(stderr, "dotnet : CoreCLR refuse de demarrer, %08x\n", (unsigned)hr);
+        return 1;
+    }
+    unsigned int code = 0;
+    hr = coreclr_execute_assembly(host, domain, argc - 2, argv + 2, path.c_str(), &code);
+    if (hr < 0)
+    {
+        fprintf(stderr, "dotnet : %s n'a pas demarre, %08x\n", app, (unsigned)hr);
+        code = 1;
+    }
+    int latched = (int)code;
+    coreclr_shutdown_2(host, domain, &latched);
+    return latched;
+}
