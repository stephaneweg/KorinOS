#include <windows.h>
#include "dialogs.h"

MainMenu MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Input...\tCtrl+I", IDM_INPUT
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Timer"
    BEGIN
        MENUITEM "&Counting", IDM_COUNT, CHECKED
        MENUITEM "&Reset", IDM_RESET
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...", IDM_ABOUT
    END
END

MainAccel ACCELERATORS
BEGIN
    "^I", IDM_INPUT
    VK_F1, IDM_ABOUT, VIRTKEY
END

STRINGTABLE
BEGIN
    IDS_HELLO, "Hello, %s! Size %d, fruit: %s%s"
END

IDD_ABOUT DIALOG 20, 20, 160, 70
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About dialogs"
FONT 8, "MS Sans Serif"
BEGIN
    CTEXT "Win16 test program", -1, 10, 10, 140, 10
    CTEXT "Menus, dialogs and controls", -1, 10, 24, 140, 10
    DEFPUSHBUTTON "OK", IDOK, 55, 46, 50, 14
END

IDD_INPUT DIALOG 20, 20, 200, 150
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Your input"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "&Name:", -1, 8, 10, 40, 10
    EDITTEXT IDC_NAME, 50, 8, 140, 12, ES_AUTOHSCROLL
    CONTROL "&Loud greeting", IDC_LOUD, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 26, 100, 10
    GROUPBOX "Size", -1, 8, 40, 80, 56
    CONTROL "&Small", IDC_SMALL, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 14, 52, 60, 10
    CONTROL "&Medium", IDC_MEDIUM, "BUTTON", BS_AUTORADIOBUTTON, 14, 64, 60, 10
    CONTROL "La&rge", IDC_LARGE, "BUTTON", BS_AUTORADIOBUTTON, 14, 76, 60, 10
    LTEXT "Colors:", -1, 96, 40, 60, 10
    LISTBOX IDC_COLORS, 96, 50, 94, 46, WS_VSCROLL | WS_TABSTOP
    LTEXT "Fruit:", -1, 8, 104, 30, 10
    COMBOBOX IDC_FRUIT, 40, 102, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 86, 128, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 142, 128, 50, 14
END
