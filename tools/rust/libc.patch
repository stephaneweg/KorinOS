+safe_f! {
+    pub const fn WIFEXITED(status: c_int) -> bool {
+        (status & 0xff) == 0
+    }
+
+    pub const fn WEXITSTATUS(status: c_int) -> c_int {
+        (status >> 8) & 0xff
+    }
+
+    pub const fn WIFSIGNALED(status: c_int) -> bool {
+        (status & 0x7f) > 0 && (status & 0x7f) < 0x7f
+    }
+
+    pub const fn WTERMSIG(status: c_int) -> c_int {
+        status & 0x7f
+    }
