diff -ruN a/compiler/rustc_target/src/spec/targets/aarch64_unknown_korin.rs b/compiler/rustc_target/src/spec/targets/aarch64_unknown_korin.rs
--- a/compiler/rustc_target/src/spec/targets/aarch64_unknown_korin.rs
+++ b/compiler/rustc_target/src/spec/targets/aarch64_unknown_korin.rs
@@ -0,0 +1,26 @@
+use crate::spec::{Arch, FramePointer, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::korin::opts();
+    // the Raspberry Pi 4 (no LSE on the Cortex-A72: LL/SC atomics inline, no outline atomics)
+    base.cpu = "cortex-a72".into();
+    base.features = "+v8a,+crc".into();
+    base.max_atomic_width = Some(128);
+    base.frame_pointer = FramePointer::NonLeaf;
+
+    Target {
+        llvm_target: "aarch64-unknown-none-elf".into(),
+        metadata: TargetMetadata {
+            description: Some("ARM64 Korin OS (Raspberry Pi 4)".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout:
+            "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
+                .into(),
+        arch: Arch::AArch64,
+        options: base,
+    }
+}
