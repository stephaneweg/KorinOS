diff -ruN a/compiler/rustc_target/src/spec/base/korin.rs b/compiler/rustc_target/src/spec/base/korin.rs
--- a/compiler/rustc_target/src/spec/base/korin.rs
+++ b/compiler/rustc_target/src/spec/base/korin.rs
@@ -0,0 +1,31 @@
+//! Korin OS: a microkernel operating system for the Raspberry Pi 4 and x86-64 PCs, with a POSIX layer
+//! (newlib 4.4 and libposix) on which Rust's `std` takes the generic Unix paths.
+//! See `src/doc/rustc/src/platform-support/korin.md`.
+
+use crate::spec::{Env, Os, RelroLevel, StackProbeType, TargetOptions, cvs};
+
+pub(crate) fn opts() -> TargetOptions {
+    TargetOptions {
+        os: Os::Korin,
+        env: Env::Newlib,
+        families: cvs!["unix"],
+        // GCC with libposix's specs: on Korin, `gcc` links crt0, libposix, newlib and the system's
+        // linker script itself; when cross-compiling, point `linker` at that GCC.
+        linker: Some("gcc".into()),
+        // the C driver chooses the libraries (libposix, newlib, libm), not rustc
+        no_default_libraries: false,
+        executables: true,
+        // shared objects are `dlopen` modules (cdylib, proc-macro, dylib); executables are linked
+        // at the fixed address of libposix's linker script, without PIE
+        dynamic_linking: true,
+        position_independent_executables: false,
+        static_position_independent_executables: false,
+        has_rpath: true,
+        // libposix's linker script has no RELRO segment
+        relro_level: RelroLevel::None,
+        has_thread_local: true,
+        stack_probes: StackProbeType::Inline,
+        default_uwtable: true,
+        ..Default::default()
+    }
+}
