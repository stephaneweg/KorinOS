#!/bin/bash
# git-credential-korin : l'assistant d'identification de git (gitcredentials, « credential.helper = korin » de
# /etc/gitconfig) sur le coffre à secrets de Korin (docs/KEYVAULT.md, docs/GIT.md), par la commande secret.
#
#   git credential-korin get | store | erase      (git le lance : les lignes « clé=valeur » sur l'entrée)
#
# Le coffre reconnaît ce script par son chemin (/bin/git-credential-korin) : tous les comptes de git sont dans son
# espace, à lui seul, sans fichier en clair (au contraire de credential-store et de ~/.git-credentials) :
#   git/<hôte>/<compte>     le mot de passe ou le jeton du compte sur cet hôte (« hôte:port » s'il y a un port)
#   git/<hôte>/@default     le dernier compte enregistré pour cet hôte (quand git ne donne pas de compte)
# Les caractères qu'un nom n'admet pas deviennent « _ ». Sans coffre (le Pi) : rien n'est gardé ici.
#
# GitHub (https://github.com, docs/GIT.md « GitHub », docs/etude/GH.md §5) : sans jeton au coffre, celui du compte
# OAuth « github » d'oauthd (commande oauth, docs/OAUTH.md) ; pas encore connecté, la connexion par code
# d'appareil, comme le Git Credential Manager :
#   Sur un téléphone ou un ordinateur, ouvrez : https://github.com/login/device  et tapez le code : ABCD-1234
# Sans client_id (ni dans /etc/oauth/providers.ini, ni dans le compte) : une fois, la création de l'OAuth App
# « Korin » de l'utilisateur, dont le Client ID est demandé. Les messages vont sur la sortie d'erreur (git lit la
# sortie), les questions sur le terminal (/dev/tty) ; GIT_TERMINAL_PROMPT=0 : rien de tout cela, seulement un
# jeton déjà là. Le jeton d'une OAuth App ne périme pas : oauthd le garde (chiffré, ou au coffre).

op=$1
protocol= host= username= password=
while IFS= read -r line; do
	line=${line%$'\r'}
	[ -z "$line" ] && break
	key=${line%%=*}
	val=${line#*=}
	case $key in
	protocol) protocol=$val ;;
	host) host=$val ;;
	username) username=$val ;;
	password) password=$val ;;
	esac
done
[ -n "$host" ] || exit 0
vault=
command -v secret > /dev/null 2>&1 && vault=1
github=
[ "$host" = github.com ] && [ "$protocol" = https ] && command -v oauth > /dev/null 2>&1 && github=1
[ -n "$vault$github" ] || exit 0

# un morceau de nom : lettres, chiffres, . _ - @ : (60 octets au plus)
clean() {
	local s=${1//[^A-Za-z0-9._@:-]/_}
	printf %s "${s:0:60}"
}

h=$(clean "$host")
base="git/$h"

# ---- GitHub

GH_ACCOUNT=github			# le compte d'oauthd
GH_SCOPE="repo workflow"		# pousser (dépôts privés compris) et les fichiers de .github/workflows
GH_USER=x-access-token			# le nom rendu quand git n'en donne pas (GitHub ne regarde que le jeton)
GH_NEW_APP=https://github.com/settings/applications/new
GH_DEVICE=https://github.com/login/device
JET=/apps/jet.app/main
TTY=${KORIN_CREDENTIAL_TTY:-/dev/tty}	# (les essais : un autre fichier)

say() { printf '%s\n' "$*" >&2; }

# une question sur le terminal -> REPLY ; 1 : pas de terminal
ask() {
	REPLY=
	[ -n "$tty_ok" ] || return 1
	printf '%s' "$1" >&2
	IFS= read -r REPLY < "$TTY" || return 1
	REPLY=${REPLY%$'\r'}
}

# une page dans Jet, si l'utilisateur l'a voulu (détachée : git attend la fin de notre sortie)
open_jet() {
	[ -n "$use_jet" ] || return 0
	"$JET" "$1" < /dev/null > /dev/null 2>&1 &
}

# la création de l'OAuth App « Korin » de l'utilisateur, puis son Client ID dans le compte « github »
github_app() {
	say "GitHub : Korin a besoin d'une « OAuth App » à votre nom (une seule fois). Sur $GH_NEW_APP :"
	say "  Application name            : Korin"
	say "  Homepage URL                : http://127.0.0.1"
	say "  Authorization callback URL  : http://127.0.0.1"
	say "  Enable Device Flow          : à cocher"
	say "puis « Register application », et copiez son « Client ID »."
	open_jet "$GH_NEW_APP"
	if ! ask "Client ID : "; then
		say "(pas de terminal pour le demander : oauth setup $GH_ACCOUNT provider=github client_id=… scope='$GH_SCOPE')"
		return 1
	fi
	local cid=${REPLY//[[:space:]]/}
	case $cid in
	'' | *[!A-Za-z0-9._-]*)
		say "GitHub : Client ID invalide."
		return 1
		;;
	esac
	oauth setup "$GH_ACCOUNT" provider=github "client_id=$cid" "scope=$GH_SCOPE" > /dev/null || return 1
}

# le jeton du compte « github » d'oauthd sur la sortie, en connectant le compte s'il le faut
github_token() {
	if oauth status "$GH_ACCOUNT" > /dev/null 2>&1; then
		oauth token "$GH_ACCOUNT" 2> /dev/null && return 0
	fi
	[ "$GIT_TERMINAL_PROMPT" = 0 ] && return 1
	tty_ok=
	{ : < "$TTY"; } 2> /dev/null && tty_ok=1
	use_jet=
	if [ -f "$JET" ] && ask "GitHub : ouvrir ses pages dans Jet, sur cet écran ? [O/n] "; then
		case $REPLY in
		[nN]*) ;;
		*) use_jet=1 ;;
		esac
	fi
	# le compte : le client de Korin (providers.ini) s'il y en a un, sinon l'OAuth App de l'utilisateur
	if ! oauth info "$GH_ACCOUNT" > /dev/null 2>&1; then
		oauth setup "$GH_ACCOUNT" provider=github "scope=$GH_SCOPE" > /dev/null 2>&1 || github_app || return 1
	fi
	say "GitHub : connexion de Korin à votre compte."
	open_jet "$GH_DEVICE"
	oauth login "$GH_ACCOUNT" >&2 || return 1
	oauth token "$GH_ACCOUNT" 2> /dev/null
}

case $op in
get)
	user=$username pw=
	if [ -n "$vault" ]; then
		[ -n "$user" ] || user=$(secret get "$base/@default" 2> /dev/null)
		[ -n "$user" ] && pw=$(secret get "$base/$(clean "$user")" 2> /dev/null)
	fi
	if [ -z "$pw" ] && [ -n "$github" ]; then
		pw=$(github_token) || pw=
		[ -n "$user" ] || user=$GH_USER
	fi
	[ -n "$user" ] && [ -n "$pw" ] || exit 0
	printf 'username=%s\npassword=%s\n' "$user" "$pw"
	pw=
	;;
store)
	[ -n "$vault" ] || exit 0
	[ -n "$username" ] && [ -n "$password" ] || exit 0
	printf %s "$password" | secret set "$base/$(clean "$username")" 2> /dev/null || exit 0
	printf %s "$username" | secret set "$base/@default" 2> /dev/null
	password=
	;;
erase)
	# (GitHub a refusé le jeton d'oauthd : révoqué, ou l'OAuth App retirée) : il est oublié, la prochaine fois
	# reconnecte le compte
	if [ -n "$github" ] && [ -n "$password" ] && [ "$password" = "$(oauth token "$GH_ACCOUNT" 2> /dev/null)" ]; then
		oauth forget "$GH_ACCOUNT" > /dev/null 2>&1
	fi
	[ -n "$vault" ] || exit 0
	[ -n "$username" ] || username=$(secret get "$base/@default" 2> /dev/null)
	[ -n "$username" ] || exit 0
	secret rm "$base/$(clean "$username")" 2> /dev/null
	[ "$(secret get "$base/@default" 2> /dev/null)" = "$username" ] && secret rm "$base/@default" 2> /dev/null
	;;
esac
exit 0
