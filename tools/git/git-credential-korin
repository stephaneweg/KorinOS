#!/bin/bash
# git-credential-korin : l'assistant d'identification de git (gitcredentials, « credential.helper = korin » de
# /etc/gitconfig) sur le coffre à secrets de Korin (docs/KEYVAULT.md, docs/GIT.md), par la commande secret.
#
#   git credential-korin get | store | erase      (git le lance : les lignes « clé=valeur » sur l'entrée)
#
# Le coffre reconnaît ce script par son chemin (/bin/git-credential-korin) : tous les comptes de git sont dans son
# espace, à lui seul, sans fichier en clair (au contraire de credential-store et de ~/.git-credentials) :
#   git/<hôte>/<compte>     le mot de passe ou le jeton du compte sur cet hôte (« hôte:port » s'il y a un port)
#   git/<hôte>/@default     le dernier compte enregistré pour cet hôte (quand git ne donne pas de compte)
# Les caractères qu'un nom n'admet pas deviennent « _ ». Sans coffre (le Pi) : rien n'est rendu ni gardé, git
# demande le mot de passe comme avant.

op=$1
host= username= password=
while IFS= read -r line; do
	line=${line%$'\r'}
	[ -z "$line" ] && break
	key=${line%%=*}
	val=${line#*=}
	case $key in
	host) host=$val ;;
	username) username=$val ;;
	password) password=$val ;;
	esac
done
[ -n "$host" ] || exit 0
command -v secret > /dev/null 2>&1 || exit 0

# un morceau de nom : lettres, chiffres, . _ - @ : (60 octets au plus)
clean() {
	local s=${1//[^A-Za-z0-9._@:-]/_}
	printf %s "${s:0:60}"
}

h=$(clean "$host")
base="git/$h"

case $op in
get)
	user=$username
	[ -n "$user" ] || user=$(secret get "$base/@default" 2> /dev/null) || exit 0
	[ -n "$user" ] || exit 0
	pw=$(secret get "$base/$(clean "$user")" 2> /dev/null) || exit 0
	[ -n "$pw" ] || exit 0
	printf 'username=%s\npassword=%s\n' "$user" "$pw"
	pw=
	;;
store)
	[ -n "$username" ] && [ -n "$password" ] || exit 0
	printf %s "$password" | secret set "$base/$(clean "$username")" 2> /dev/null || exit 0
	printf %s "$username" | secret set "$base/@default" 2> /dev/null
	password=
	;;
erase)
	[ -n "$username" ] || username=$(secret get "$base/@default" 2> /dev/null) || exit 0
	[ -n "$username" ] || exit 0
	secret rm "$base/$(clean "$username")" 2> /dev/null
	[ "$(secret get "$base/@default" 2> /dev/null)" = "$username" ] && secret rm "$base/@default" 2> /dev/null
	;;
esac
exit 0
