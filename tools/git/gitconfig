# /etc/gitconfig : la configuration de git pour tout le systeme (docs/GIT.md).
# FAT32 et exFAT : ni bit d'execution, ni liens, pas de casse, une seule date a 2 s pres.
[core]
	filemode = false
	symlinks = false
	ignorecase = true
	checkStat = minimal
	trustctime = false
	pager = cat
	# 64 fichiers ouverts par process : peu de paquets ouverts a la fois
	packedGitLimit = 64m
	packedGitWindowSize = 4m
	deltaBaseCacheLimit = 16m
	preloadIndex = false
	fsmonitor = false
	untrackedCache = false
[pack]
	windowMemory = 64m
# pas de paquet « cruft » : ses noms temporaires (.tmp-<pid>-pack-<sha1>.mtimes) passent les 63
# octets d'un nom sur /tmp
[gc]
	cruftPacks = false
[init]
	defaultBranch = main
[http]
	sslCAInfo = /etc/ca-bundle
[color]
	ui = auto
[advice]
	detachedHead = false
# les mots de passe et jetons de https : dans le coffre a secrets (/bin/git-credential-korin, sur la
# commande secret ; docs/GIT.md), pas en clair comme credential-store. Sans coffre (le Pi) : rien n'est garde.
[credential]
	helper = korin
# une seule identite (uid 0) : pas de controle de proprietaire
[safe]
	directory = *
