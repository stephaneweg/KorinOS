+    @model_serializer(mode="wrap")
+    def _without_code_mode(self, handler: Any) -> Any:
+        """Korin: a Core built without V8 has no programs.
+
+        Core then refuses programmatic-only tools and connector groups, and
+        MCP, connector, plugin and client tools are programmatic-only by
+        default. On the way to Core (and to storage), they become direct tools
+        named `<group>_<tool>`, and connector groups, which Core only runs from
+        a program, are left out. Done when serialising, because capability sets
+        are also built by `model_copy(update=...)`, which skips validators.
+        """
+        data = handler(self)
+        if _code_mode_available() or not isinstance(data, dict):
+            return data
+        groups = []
+        for group in data.get("tool_groups") or []:
+            if group.get("metadata") is not None:
+                continue
+            tools = []
+            for tool in group.get("tools") or []:
+                if tool.get("exposure") == "programmatic":
+                    tool = {
+                        **tool,
+                        "exposure": "direct",
+                        "direct_name": tool.get("direct_name")
+                        or _direct_tool_name(group["name"], tool["name"]),
+                    }
+                tools.append(tool)
+            groups.append({**group, "tools": tools})
+        data["tool_groups"] = groups
+        return data
+
+
+def _code_mode_available() -> bool:
+    from mistralai_vibe_local_harness import _native
+
+    return bool(getattr(_native, "CODE_MODE", True))
+
+
+def _direct_tool_name(group: str, tool: str) -> str:
+    # Model function names: at most 64 of [A-Za-z0-9_-].
+    name = f"{group}_{tool}"
+    if len(name) <= 64:
+        return name
+    digest = hashlib.sha256(name.encode()).hexdigest()[:8]
+    return f"{name[:55]}_{digest}"
+
 
