<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvStudio.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <x:Double x:Key="TabItemHeaderFontSize">12</x:Double>
    <x:Double x:Key="TabItemMinHeight">30</x:Double>
    <x:Double x:Key="TabItemPipeThickness">2</x:Double>
    <Thickness x:Key="TabItemHeaderMargin">10,0,10,0</Thickness>
    <FontWeight x:Key="TabItemHeaderThemeFontWeight">Normal</FontWeight>
    <x:Double x:Key="TreeViewItemMinHeight">24</x:Double>
    <StreamGeometry x:Key="IconOpen">M1.5 13.5V3.5h4.5l1.5 2h7v8z</StreamGeometry>
    <StreamGeometry x:Key="IconSave">M2.5 2.5h9l2 2v9h-11z M5 2.5v3.5h5v-3.5 M5 13.5v-4.5h6v4.5</StreamGeometry>
    <StreamGeometry x:Key="IconBuild">M2.5 8.5l3.5 3.5 7.5-8</StreamGeometry>
    <StreamGeometry x:Key="IconRun">M4.5 2.5l9 5.5-9 5.5z</StreamGeometry>
    <StreamGeometry x:Key="IconControl">M2.5 2.5h11v11h-11z M5.5 5.5h5v5h-5z</StreamGeometry>
    <StreamGeometry x:Key="IconWindow">M1.5 3.5h13v9h-13z M1.5 6.5h13</StreamGeometry>
    <StreamGeometry x:Key="IconPanel">M1.5 3.5h13v9h-13z M1.5 9.5h13</StreamGeometry>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <Style Selector="Window">
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- les separateurs : un trait fin, la poignee reste large a saisir -->
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinWidth" Value="5" />
      <Setter Property="MinHeight" Value="5" />
    </Style>

    <!-- la barre d'outils : des boutons plats, icone et texte -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.tool /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
    </Style>
    <Style Selector="Button.tool:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.tool Path">
      <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary Path">
      <Setter Property="Stroke" Value="White" />
    </Style>

    <!-- les panneaux : titres petits, densite d'un outil de travail -->
    <Style Selector="TabControl.panel">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="TextBox.prop, ComboBox.prop">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.bar">
      <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="Border.status TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.status">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    </Style>
  </Application.Styles>
</Application>
