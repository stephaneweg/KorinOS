+/* Korin : le code NT qu'un gestionnaire du serveur donne avant de rendre -1 */
+static uint32_t smb2_server_status_next;
+void smb2_set_server_status(uint32_t status)
+{
+        smb2_server_status_next = status;
+}
+static uint32_t smb2_take_server_status(void)
+{
+        uint32_t st = smb2_server_status_next ? smb2_server_status_next : SMB2_STATUS_NOT_IMPLEMENTED;
+        smb2_server_status_next = 0;
+        return st;
+}
