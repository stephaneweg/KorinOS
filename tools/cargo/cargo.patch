+/// Korin OS: the toolchain's directory, the parent of cargo's `bin/` (`/devtools/rust`).
+#[cfg(target_os = "korin")]
+pub fn korin_toolchain_dir() -> Option<PathBuf> {
+    let exe = std::env::current_exe().ok()?;
+    Some(exe.parent()?.parent()?.to_path_buf())
+}
