+
+/// Returns the size of the terminal using the given file descriptor, if available.
+///
+/// Korin : rustix n'y a pas termios ; isatty et l'ioctl TIOCGWINSZ de la libc (libposix).
+#[cfg(target_os = "korin")]
+pub fn terminal_size_of<Fd: AsFd>(fd: Fd) -> Option<(Width, Height)> {
+    use std::os::unix::io::AsRawFd;
+    let fd = fd.as_fd().as_raw_fd();
+    // SAFETY: un descripteur valable (AsFd) et un winsize rempli par l'ioctl
+    let ws = unsafe {
+        if libc::isatty(fd) != 1 {
+            return None;
+        }
+        let mut ws: libc::winsize = std::mem::zeroed();
+        if libc::ioctl(fd, libc::TIOCGWINSZ, &mut ws) != 0 {
+            return None;
+        }
+        ws
+    };
+    if ws.ws_row > 0 && ws.ws_col > 0 {
+        Some((Width(ws.ws_col), Height(ws.ws_row)))
+    } else {
+        None
+    }
 }
 
