+/// Korin : rustix n'y a pas termios ; l'écho se coupe par la libc (termios de libposix).
+#[cfg(target_os = "korin")]
+pub(crate) mod imp {
+    use std::{
+        fs::File,
+        io::{BufRead, Write},
+        os::fd::AsRawFd,
+    };
+
+    use crate::{unix::TTY_PATH, Error, Mode, Options};
+
+    /// Remet l'état du terminal (l'écho) quand elle disparaît.
+    struct Restore<'a>(&'a File, libc::termios);
+
+    impl Drop for Restore<'_> {
+        fn drop(&mut self) {
+            // SAFETY: un descripteur ouvert et un termios lu par tcgetattr
+            #[allow(unsafe_code)]
+            unsafe {
+                libc::tcsetattr(self.0.as_raw_fd(), libc::TCSAFLUSH, &self.1);
+            }
+        }
+    }
+
+    fn read_line(fd: &File) -> Result<String, Error> {
+        let mut buf_read = std::io::BufReader::with_capacity(64, fd);
+        let mut out = String::with_capacity(64);
+        buf_read.read_line(&mut out)?;
+        Ok(out)
+    }
+
+    /// Ask the user given a `prompt`, returning the result.
+    pub(crate) fn ask(prompt: &str, Options { mode, .. }: &Options<'_>) -> Result<String, Error> {
+        if let Mode::Disable = mode {
+            return Err(Error::Disabled);
+        }
+        let mut fd = std::fs::OpenOptions::new().write(true).read(true).open(TTY_PATH)?;
+        if let Mode::Visible = mode {
+            fd.write_all(prompt.as_bytes())?;
+            return Ok(read_line(&fd)?.trim_end().to_owned());
+        }
+        // SAFETY: un termios rempli par tcgetattr avant usage
+        #[allow(unsafe_code)]
+        let prev = unsafe {
+            let mut t: libc::termios = std::mem::zeroed();
+            if libc::tcgetattr(fd.as_raw_fd(), &mut t) != 0 {
+                return Err(std::io::Error::last_os_error().into());
+            }
+            t
+        };
+        let mut new = prev;
+        new.c_lflag &= !libc::ECHO;
+        new.c_lflag |= libc::ECHONL;
+        // SAFETY: comme plus haut
+        #[allow(unsafe_code)]
+        if unsafe { libc::tcsetattr(fd.as_raw_fd(), libc::TCSAFLUSH, &new) } != 0 {
+            return Err(std::io::Error::last_os_error().into());
+        }
+        let restore = Restore(&fd, prev);
+        (&fd).write_all(prompt.as_bytes())?;
+        let mut out = read_line(&fd)?;
+        drop(restore);
+        out.pop();
+        if out.ends_with('\r') {
+            out.pop();
+        }
+        Ok(out)
+    }
+}
